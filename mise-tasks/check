#!/usr/bin/env bash
#MISE tags=["macos"]
# The repo's own self-test, wired automatic: the pre-commit/pre-push hooks
# hooks (mise-tasks/hooks, gated by core.hooksPath, which the pre-packages hook sets) reject
# unchecked trees, and the final hook ends every bootstrap with this task. Five legs:
#
#   1. config gate   -- the pre-packages assertion (mise.toml) at commit-time: `mise
#                       env` IS the config load and a typo'd key only warns, so the
#                       gate fails on unknown fields instead of passing them through.
#   2. shellcheck    -- every task script and helper in the repo.
#   3. idempotence   -- `mise dot diff` must be empty: converged means nothing left to
#                       deploy; a diff is drift between declared state and this machine.
#   4. heartbeat     -- the weekly pin-check agent is loaded and its log written within
#                       8 days (pin-check's result is in the log; this leg proves the
#                       alarm clock runs).
#   5. agent jobs -- gza only (gated on HOST): the run and report
#                       agents of ha-monitor, ha-update and nwa-health are
#                       loaded and their heartbeats are fresh -- the daily
#                       jobs at most 2 days, ha-update weekly (at most 8
#                       days). The ntfy reports are the human-facing alarms;
#                       this leg catches a dead clock that cannot alarm
#                       itself.
#
# The omp sandbox denies the dotfiles' target paths, so leg 3 self-skips there with a
# note -- run this task from a normal shell for it to mean anything.

set -uo pipefail   # no -e: every leg runs and reports; the exit code sums up

rc=0
if [ "$(uname -s)" != "Darwin" ]; then
  echo "check is macOS-only (its dotfiles and launchd legs are); skipping."
  exit 0
fi

# The omp sandbox answers EPERM for ~/Library, and a bare test reads a denial
# as absence -- ask ls what it saw: "visible", "absent", or "denied".
file_state() {
  local out
  out=$(ls -d "$1" 2>&1) && { echo visible; return; }
  case "$out" in *"Operation not permitted"*) echo denied ;; *) echo absent ;; esac
}

echo "== 1. config gate"
gate_err=$(mktemp)
if ! mise env >/dev/null 2>"$gate_err"; then
  cat "$gate_err" >&2; rc=1; echo "  the mise config does not parse"
elif grep -qE 'unknown field|did you mean' "$gate_err"; then
  cat "$gate_err" >&2; rc=1; echo "  unknown fields in the mise config"
else
  echo "  config loads clean"
fi
rm -f "$gate_err"

echo "== 2. shellcheck"
if ! command -v shellcheck >/dev/null 2>&1; then
  echo "  shellcheck missing -- it is in the Brewfile; mise run brew-bundle" >&2
  rc=1
else
  # find, not a glob: shellcheck refuses a directory argument without -r, so a plain
  # glob hands it mise-tasks/hooks. -x follows `# shellcheck source=` into _defaults.sh.
  if find mise-tasks -type f -print0 | xargs -0 shellcheck -x nono/omp-wrapper.sh; then
    echo "  clean: $(find mise-tasks -type f | wc -l | tr -d ' ') task scripts + wrapper + hooks"
  else
    rc=1
  fi
fi

echo "== 3. dotfiles idempotence"
# The sandbox probe: the omp sandbox answers EPERM for the target dir; the
# same absence looks identical to `[ -e ]`, so ask ls what it saw.
probe=$(ls "$HOME/.config/starship.toml" 2>&1)
case "$probe" in
  *"Operation not permitted"*)
    echo "  sandboxed shell: dotfile targets unreadable, leg skipped -- run outside the omp sandbox"
    ;;
  *)
    if diff_out=$(mise dot diff 2>&1); then
      echo "  no drift: the deployed files match the repo"
    else
      printf '%s\n' "$diff_out" | grep -E '^dotfile differs' >&2 || printf '%s\n' "$diff_out" >&2
      rc=1; echo "  drift above: mise dotfiles apply (or mise bootstrap) to converge, else commit the live edits"
    fi
    ;;
esac

echo "== 4. pin-check heartbeat"
agent="gui/$(id -u)/dev.mise.pin-check"
log="$HOME/Library/Logs/pin-check.log"
if ! launchctl print "$agent" >/dev/null 2>&1; then
  rc=1; echo "  dev.mise.pin-check not loaded -- mise bootstrap macos launchd-agents apply" >&2
elif [ ! -f "$log" ]; then
  # Grace for a just-installed agent: the final hook runs check on every bootstrap and a
  # fresh install has not reached its first calendar time yet. Past the grace: dead.
  # The sandbox denies ~/Library/LaunchAgents; an unreadable install date is
  # reported as such, never asserted as "never run".
  plist="$HOME/Library/LaunchAgents/dev.mise.pin-check.plist"
  case "$(file_state "$plist")" in
    visible)
      if [ -n "$(find "$plist" -mtime -9 2>/dev/null)" ]; then
        echo "  agent installed, first heartbeat pending -- seed the log with: mise run pin-check"
      else
        rc=1; echo "  agent loaded but $(basename "$log") missing -- it has never run: mise run pin-check" >&2
      fi ;;
    denied)
      echo "  log missing and the install date is unreadable in the sandbox -- unverifiable here; the bootstrap check run is the gate" ;;
    *)
      rc=1; echo "  agent loaded but the plist is absent -- $(basename "$log") cannot appear: mise bootstrap macos launchd-agents apply" >&2 ;;
  esac
else
  # The newest DATE-STAMPED line, not the newest line: pin-check's summary
  # is one dated line per run, and nothing else may pass as a heartbeat
  # (the agent's own stdout has its file since 2026-11-12; logs before that
  # carry interleaved mise chatter).
  last_line=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$log" | tail -1)
  if [ -z "$last_line" ]; then
    rc=1; echo "  log holds no dated heartbeat line: $(tail -1 "$log")" >&2
  elif last_epoch=$(date -j -f '%Y-%m-%d' "${last_line%% *}" +%s 2>/dev/null); then
    age=$(( ($(date +%s) - last_epoch) / 86400 ))
    echo "  last run ${age}d ago: $last_line"
    if [ "$age" -gt 8 ]; then
      rc=1; echo "  weekly heartbeat stale (>8d): the agent is not firing" >&2
    fi
  else
    rc=1; echo "  heartbeat line carries no parseable date: $last_line" >&2
  fi
fi

echo "== 5. agent jobs heartbeat (gza)"
# The host gate is HOST, not plist readability: the sandbox denies
# ~/Library/LaunchAgents, and a bare test read that denial as "not gza" -- on
# gza. launchctl and ~/Library/Logs answer through the sandbox, as leg 4
# proves. ha-monitor and nwa-health fire daily (fresh <=2d), ha-update weekly (<=8d).
if [ -z "${HOST:-}" ]; then
  echo "  HOST unset -- run through mise (the host module sets it): skipped"
elif [ "$HOST" != "gza" ]; then
  echo "  not gza (HOST=${HOST}): skipped"
else
for jm in "ha-monitor:2" "ha-update:8" "nwa-health:2"; do
  jm_name="${jm%%:*}"; jm_max="${jm##*:}"
  jm_plist="$HOME/Library/LaunchAgents/dev.mise.${jm_name}.plist"
  jm_log="$HOME/Library/Logs/${jm_name}.log"
  if ! launchctl print "gui/$(id -u)/dev.mise.${jm_name}" >/dev/null 2>&1 \
    || ! launchctl print "gui/$(id -u)/dev.mise.${jm_name}-report" >/dev/null 2>&1; then
    rc=1; echo "  ${jm_name} agents not loaded -- mise bootstrap macos launchd-agents apply" >&2
  elif [ ! -f "$jm_log" ]; then
    # The grace window is the job's own freshness bound, not a flat 2 days:
    # ha-update's weekly clock may legitimately not have fired yet. Denial
    # says "unverifiable here" instead of asserting: the bootstrap final-hook
    # check (unsandboxed) is where this branch has teeth.
    case "$(file_state "$jm_plist")" in
      visible)
        if [ -n "$(find "$jm_plist" -mtime "-$((jm_max + 1))" 2>/dev/null)" ]; then
          echo "  ${jm_name}: agents installed, first heartbeat pending -- seed the log with: mise run ${jm_name}"
        else
          rc=1; echo "  ${jm_name} agents loaded but $(basename "$jm_log") missing -- they have never run: mise run ${jm_name}" >&2
        fi ;;
      denied)
        echo "  ${jm_name}: log missing and the install date is unreadable in the sandbox -- unverifiable here; the bootstrap check run is the gate" ;;
      *)
        rc=1; echo "  ${jm_name} agents loaded but the plist is absent -- $(basename "$jm_log") cannot appear: mise bootstrap macos launchd-agents apply" >&2 ;;
    esac
  else
    last_line=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} ' "$jm_log" | tail -1)
    if [ -z "$last_line" ]; then
      rc=1; echo "  ${jm_name}: log holds no dated heartbeat line: $(tail -1 "$jm_log")" >&2
    elif last_epoch=$(date -j -f '%Y-%m-%d' "${last_line%% *}" +%s 2>/dev/null); then
      age=$(( ($(date +%s) - last_epoch) / 86400 ))
      echo "  ${jm_name}: last run ${age}d ago: $last_line"
      if [ "$age" -gt "$jm_max" ]; then
        rc=1; echo "  ${jm_name} heartbeat stale (>${jm_max}d): the agent is not firing" >&2
      fi
    else
      rc=1; echo "  ${jm_name}: heartbeat line carries no parseable date: $last_line" >&2
    fi
  fi
done
fi

if [ "$rc" -eq 0 ]; then
  echo "check: all legs pass"
else
  echo "check: FAILED legs above" >&2
fi
exit "$rc"

#!/usr/bin/env bash
#MISE tags=["macos"]
# A diffable manifest of app state on this Mac: what lives in ~/Library that the repo
# does not own, annotated by who does. It answers "what has not transferred between
# the Macs yet". Run it on both hosts (a terminal, not the omp sandbox -- the
# app-support trees are denied there), then diff the comment-stripped files:
#   diff <(grep -v '^#' inventory-gza.txt) <(grep -v '^#' inventory-mca.txt)
# A '?' row on one host only is the backlog: not transferred, not in the repo, not
# brew'd, not syncthing'd. Account rows diff separately; credentials stay in the
# first host's keychain, the manifest only says WHICH.
#
# Annotation per line, first match wins: repo (a [dotfiles] target, a domain in the
# declarative UI list _defaults.sh, or a mise-deployed plist), brew:<tok> (an
# installed cask's bundle id or app name), sync (under a syncthing share, read from
# the live config), ? (none of the above -- a finding).
#
# The saved manifest holds only stable fields (kind, origin, item) so hosts diff
# cleanly; sizes go to stdout only, which is also why --quick skips the du pass.
# Sections: appsupport, container, group, prefs (non-Apple domains), agent,
# systemagent (/Library), account. Apple-owned entries are filtered out.
set -euo pipefail
shopt -s nullglob

if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi
quick=""
[ "${1:-}" = "--quick" ] && quick=1

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB="$HOME/Library"

lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# The omp sandbox probe (the check task's idiom): a partial manifest would poison
# every diff, so refuse instead of writing one.
probe=$(ls "$LIB/Application Support" 2>&1) || true
case "$probe" in
  *"Operation not permitted"*)
    echo "inventory: the omp sandbox denies ~/Library/Application Support -- run this task from a normal terminal." >&2
    exit 1
    ;;
esac
# The FDA probe (system-check's): without it the account db may read empty.
if ! head -c1 "/Library/Application Support/com.apple.TCC/TCC.db" >/dev/null 2>&1; then
  echo "NOTE: no Full Disk Access on this shell; the account section may be blind." >&2
fi

host="${HOST:-$(scutil --get LocalHostName 2>/dev/null || hostname -s)}"
out="$LIB/Logs/inventory-$host.txt"
mkdir -p "$LIB/Logs"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
: > "$tmp/repo"; : > "$tmp/repo-domains"; : > "$tmp/cask-apps"
: > "$tmp/brew-bundle"; : > "$tmp/brew-name"; : > "$tmp/shares"

# --- annotation inputs -----------------------------------------------------
# repo: every [dotfiles] target of the loaded config, expanded.
mise dot ls --json 2>/dev/null | jq -r '.files[].target' | sed "s|^~|$HOME|" > "$tmp/repo" || true
# repo: the declarative UI domains bootstrap writes.
# shellcheck source=mise-tasks/_defaults.sh
source "$REPO/mise-tasks/_defaults.sh"
for d in "${_UI_DOMAINS[@]}"; do printf '%s\n' "$d"; done >> "$tmp/repo-domains"
# brew: installed casks -> bundle id (plutil reads Info.plist; `defaults` wants a
# context plain shells lack) and app name.
brew info --cask --installed --json=v2 2>/dev/null \
  | jq -r '.casks[] | .token as $t | (.artifacts[]? | objects | select(has("app")) | .app[]? | [$t, .] | @tsv)' \
  > "$tmp/cask-apps" || true
# Tokens the info JSON skipped (pkg-style casks) or went stale on: the per-cask
# file list names the installed .app directly.
cut -f1 "$tmp/cask-apps" | LC_ALL=C sort -u > "$tmp/have"
brew list --cask 2>/dev/null | LC_ALL=C sort > "$tmp/toks" || true
while IFS= read -r t; do
  app=$(brew list --cask "$t" 2>/dev/null \
          | grep -m1 -E '\.app$' || true)
  [ -n "$app" ] && printf '%s\t%s\n' "$t" "${app#/Applications/}" >> "$tmp/cask-apps"
done < <(LC_ALL=C comm -23 "$tmp/toks" "$tmp/have")
while IFS=$'\t' read -r token app; do
  # The info JSON's path can go stale; the bare app name is the second candidate.
  p=""
  for c in "/Applications/$app" "$HOME/Applications/$app" \
           "/Applications/${app##*/}" "$HOME/Applications/${app##*/}"; do
    [ -d "$c" ] && { p="$c"; break; }
  done
  bid=""
  [ -n "$p" ] && bid=$(plutil -extract CFBundleIdentifier raw "$p/Contents/Info.plist" 2>/dev/null || true)
  [ -n "$bid" ] && printf '%s\t%s\n' "$bid" "$token" >> "$tmp/brew-bundle"
  a=${app%.app}; a=${a##*/}
  printf '%s\t%s\n' "$(lc "$a")" "$token" >> "$tmp/brew-name"
done < "$tmp/cask-apps"
# the token itself names some state dirs (obsidian/, vscodium/)
while IFS= read -r t; do printf '%s\t%s\n' "$(lc "$t")" "$t"; done \
  < <(brew list --cask 2>/dev/null || true) >> "$tmp/brew-name"
# sync: folder paths from the live syncthing config.
sed -n 's/.*<folder .*path="\([^"]*\)".*/\1/p' \
  "$LIB/Application Support/Syncthing/config.xml" > "$tmp/shares" 2>/dev/null || true

# --- helpers ----------------------------------------------------------------
lookup_in() { awk -F'\t' -v k="$1" '$1==k{print $2; exit}' "$2" 2>/dev/null; }

# repo hit: the path equals, contains, or sits inside a [dotfiles] target (a
# target's parent dir IS repo state).
under_repo() {
  local p="$1" t
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    case "$p" in "$t"|"$t"/*) return 0 ;; esac
    case "$t" in "$p"/*) return 0 ;; esac
  done < "$tmp/repo"
  return 1
}
under_share() {
  local p="$1" s
  while IFS= read -r s; do
    [ -n "$s" ] || continue
    case "$p" in "$s"|"$s"/*) return 0 ;; esac
  done < "$tmp/shares"
  return 1
}

# origin <kind> <item-name> <path-or-""> <domain-or-"">
origin() {
  local kind="$1" item="$2" path="$3" domain="$4" tok=""
  case "$kind" in
    prefs)
      grep -qxF "$domain" "$tmp/repo-domains" && { printf 'repo'; return; }
      ;;
    agent|systemagent)
      case "$item" in dev.mise.*) printf 'repo'; return ;; esac
      ;;
  esac
  if [ -n "$path" ] && under_repo "$path"; then printf 'repo'; return; fi
  tok=$(lookup_in "$domain" "$tmp/brew-bundle")
  [ -z "$tok" ] && tok=$(lookup_in "$(lc "$item")" "$tmp/brew-name")
  [ -z "$tok" ] && tok=$(lookup_in "${item#group.}" "$tmp/brew-bundle")
  if [ -n "$tok" ]; then printf 'brew:%s' "$tok"; return; fi
  if [ -n "$path" ] && under_share "$path"; then printf 'sync'; return; fi
  printf '?'
}

emit() { # kind item path domain -> manifest line
  printf '%s\t%s\t%s\n' "$1" "$(origin "$1" "$2" "$3" "$4")" "$2" >> "$tmp/body"
}

# --- sections ----------------------------------------------------------------
: > "$tmp/body"
for d in "$LIB/Application Support"/*/; do
  n=${d%/}; n=${n##*/}
  # Daemon-owned dirs (the OS's own state, not an app's) and Apple names.
  case "$n" in
    com.apple.*|AddressBook|Animoji|App\ Store|AskPermission|Automator|CallHistory*|CloudDocs|CloudKit|Configuration\ Profiles|ControlCenter|CrashReporter|DifferentialPrivacy|DiskImages|FamilySettings|FaceTime|FileProvider|IntelligenceFlow|Knowledge|MobileSync|SESStorage|SyncServices|appplaceholdersyncd|contactsd|homeenergyd|iLifeMediaBrowser|icdd|icloudmailagent|identityservicesd|locationaccessstored|networkserviceproxy|tipsd) continue ;;
  esac
  emit appsupport "$n" "${d%/}" ""
done
for d in "$LIB/Containers"/*/; do
  n=${d%/}; n=${n##*/}
  case "$n" in com.apple.*) continue ;; esac
  emit container "$n" "${d%/}" "$n"
done
for d in "$LIB/Group Containers"/*/; do
  n=${d%/}; n=${n##*/}
  # Team-id prefixes (243LU875E5.groups.com.apple.podcasts) still name Apple.
  case "$n" in group.com.apple.*|com.apple.*|*com.apple.*) continue ;; esac
  emit group "$n" "${d%/}" "$(printf '%s' "${n#group.}" | sed -E 's/^[A-Z0-9]{10}\.//')"
done
for f in "$LIB/Preferences"/*.plist; do
  n=${f##*/}; n=${n%.plist}
  case "$n" in com.apple.*|pbs|TokenBucketRateLimiter|loginwindow|ContextStoreAgent|diagnostics_agent|familycircled|localizationswitcherd|sharedfilelistd|systemgroup.*|mbuseragent|replayd|ScopedBookmarkAgent|icloudmailagent|org.sparkle-project.Sparkle.Autoupdate) continue ;; esac
  emit prefs "$n" "" "$n"
done
for f in "$LIB/LaunchAgents"/*.plist; do
  emit agent "${f##*/}" "" ""
done
for f in /Library/LaunchAgents/*.plist /Library/LaunchDaemons/*.plist; do
  n=${f##*/}
  case "$n" in com.apple.*) continue ;; esac
  emit systemagent "$n" "" ""
done
adb="$LIB/Accounts/Accounts4.sqlite"
if [ -f "$adb" ]; then
  # ZACCOUNTTYPE is an integer FK; identity is ZACCOUNTTYPE.ZIDENTIFIER (macOS 27
  # has no ZLABEL on ZACCOUNT). Ladder: names+who, names only, raw table last.
  rows=$(sqlite3 -readonly "$adb" \
          "select lower(t.ZIDENTIFIER) ||' '|| coalesce(nullif(a.ZUSERNAME,''),'')
           from ZACCOUNT a join ZACCOUNTTYPE t on a.ZACCOUNTTYPE = t.Z_PK;" \
          2>/dev/null | tr -cd '[:print:]\n' || true)
  [ -z "$rows" ] && rows=$(sqlite3 -readonly "$adb" \
          "select lower(ZIDENTIFIER) from ZACCOUNTTYPE
           where Z_PK in (select ZACCOUNTTYPE from ZACCOUNT);" \
          2>/dev/null | tr -cd '[:print:]\n' || true)
  [ -z "$rows" ] && rows=$(sqlite3 -readonly "$adb" \
          "select ZACCOUNTTYPE from ZACCOUNT;" 2>/dev/null | tr -cd '[:print:]\n' || true)
  rows=$(printf '%s\n' "$rows" | sed 's/[[:space:]]*$//')
  while IFS= read -r r; do
    [ -n "$r" ] && printf 'account\t-\t%s\n' "$r" >> "$tmp/body"
  done <<< "$rows"
fi

{
  printf '# inventory host=%s macos=%s repo=%s run=%s\n' \
    "$host" \
    "$(sw_vers -productVersion 2>/dev/null || true)-$(sw_vers -buildVersion 2>/dev/null || true)" \
    "$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || true)" \
    "$(date '+%Y-%m-%d %H:%M')"
  LC_ALL=C sort -u "$tmp/body"
} > "$tmp/manifest"

mv "$tmp/manifest" "$out"
echo "saved: $out" >&2

# --- report ------------------------------------------------------------------
# Sizes first: stdout-only data (they change between runs and would poison
# the diffs), feeding the report below. The manifest keeps names, not paths,
# so the path is rebuilt per kind.
: > "$tmp/sizes"
if [ -z "$quick" ]; then
  LC_ALL=C sort -u "$tmp/body" \
    | awk -F'\t' '$1=="appsupport"{print "A\t"$3} $1=="container"{print "C\t"$3}' \
    | while IFS=$'\t' read -r k n; do
        p="$LIB/Containers/$n"
        [ "$k" = A ] && p="$LIB/Application Support/$n"
        printf '%s\t%s\t%s\n' "$k" "$n" \
          "$(du -sk "$p" 2>/dev/null | awk \
            '{if ($1<1024) printf "%.0fK", $1;
              else if ($1<1048576) printf "%.0fM", $1/1024;
              else printf "%.1fG", $1/1048576}')"
      done > "$tmp/sizes"
fi

total=$(wc -l < "$tmp/body" | tr -d ' ')
unowned=$(awk -F'\t' '$2=="?"' "$tmp/body" | wc -l | tr -d ' ')
printf 'inventory %s -- %s entries, %s unowned (?)\n' "$host" "$total" "$unowned"

for kind in appsupport container group prefs agent systemagent account; do
  count=$(awk -F'\t' -v k="$kind" '$1==k' "$tmp/body" | wc -l | tr -d ' ')
  [ "$count" -gt 0 ] || continue
  label=$kind
  [ "$kind" = account ] && label=accounts
  printf '\n== %s (%s)\n' "$label" "$count"
  # LC_ALL=C: '?' sorts before every origin word, so the findings lead.
  awk -F'\t' -v k="$kind" '$1==k{print $2"\t"$3}' "$tmp/body" | LC_ALL=C sort \
    | while IFS=$'\t' read -r o i; do
        s="" kk=""
        [ "$kind" = appsupport ] && kk=A
        [ "$kind" = container ] && kk=C
        if [ -n "$kk" ]; then
          s=$(awk -F'\t' -v k="$kk" -v n="$i" '$1==k&&$2==n{print $3; exit}' "$tmp/sizes")
        fi
        printf '  %-42s %-20s %s\n' "$i" "$o" "$s"
      done
done

printf '\ndiff the two Macs: diff <(grep -v "^#" a.txt) <(grep -v "^#" b.txt)\n'

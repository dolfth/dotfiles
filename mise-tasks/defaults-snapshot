#!/usr/bin/env bash
# Saves a hash of the defaults domains the UI reads, taken BEFORE bootstrap
# writes the declarative defaults. system-check (final hook) compares against
# it: re-writing a value leaves the export unchanged, so a match means the
# Dock/Finder/... restart can be skipped.
set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi
source "$(dirname "${BASH_SOURCE[0]}")/_defaults.sh"

snap() {
  for d in "${_UI_DOMAINS[@]}"; do
    defaults export "$d" - 2>/dev/null || true
  done
  defaults -currentHost export com.apple.controlcenter - 2>/dev/null || true
  defaults -currentHost export NSGlobalDomain - 2>/dev/null || true
}

snap | shasum | awk '{print $1}' > "${TMPDIR:-/tmp}/mise-defaults-snapshot"

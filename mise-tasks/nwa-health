#!/usr/bin/env bash
#MISE tags=["gza"]
# The nwa health check, ported from nwa's agent-job-nwa-health (its brief:
# hosts/nwa/agent-jobs/nwa-health.md in the nixos-config flake, mirrored here
# as agent-jobs/nwa-health.md). An omp run on gza probes nwa over Tailscale
# SSH (read-only, change nothing); a second leg reports over ntfy.
#
#   mise run nwa-health            the agent run  (agent: dev.mise.nwa-health)
#   mise run nwa-health report     the ntfy report (agent: dev.mise.nwa-health-report)
#   mise run nwa-health seed       copy health-notes.md from nwa, once
#
# The state machine, the archive and the heartbeat are the ha-monitor
# pattern; what is specific to external monitoring of another machine:
#
# - The probes run over ssh: the daily sandbox denies /usr/bin/ssh (dev-agents
#   #11), so this job is the nwa-omp shape -- `nono wrap` on a profile
#   generated from the installed /usr/local/etc/nono/nwa-omp.json, where ssh
#   lives. No network allow-list: a domain proxy cannot carry ssh
#   (nolabs-ai/nono#756), so under wrap the filesystem grants are the whole
#   sandbox story: workdir READ and exactly two files WRITE (#12).
# - workDir -> ~/Documents/code/nixos-config, nwa's own flake repo: its
#   AGENTS.md is the context the agent loads, like ha-monitor's HA repo. The
#   notes and the draft sit at its root; add both to that repo's .gitignore
#   in the T9 cutover commit so the tree stays clean.
# - Preflight: the repo probe separates missing from TCC-unreadable
#   (ha-monitor's idiom), and nwa:22 must answer -- a down box is a skip
#   with a reason, not a failed run full of timeouts.
# - Timers keep nwa's clocks (run 06:13, report 12:03); timeout 60 min, nwa's
#   TimeoutStartSec. The model is the pool's flash-next behind llama-swap;
#   an eviction by another client's pick costs the job one swapped-back load,
#   like ha-monitor.
# - The report leg is unsandboxed plain bash, the only piece that posts to
#   ntfy; the shared topic file ~/.local/state/agent-jobs/ntfy_topic.
#
# First real run needs the notes: seed them from nwa (mise run nwa-health
# seed); a run without notes simply treats every open problem as new.

set -uo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "nwa-health is macOS-only (launchd clocks, nono sandbox); skipping."
  exit 0
fi

repo="$HOME/.config/mise"
nix_repo="$HOME/Documents/code/nixos-config"
state="$HOME/.local/state/agent-jobs/nwa-health"
work="$nix_repo"
notes="$work/health-notes.md"
draft="$work/report-draft.md"
ntfy_file="$HOME/.local/state/agent-jobs/ntfy_topic"
log="$HOME/Library/Logs/nwa-health.log"
profile_base="/usr/local/etc/nono/nwa-omp.json"
profile_out="$state/job.json"
nwa_host="nwa.foxhound-insen.ts.net"
nwa_known_hosts="$HOME/.omp/profiles/nwa/known_hosts"
# The splash-fn model, pinned like ha-monitor. Single-tenant behind llama-swap:
# another client's pick can evict the engine; the job's next request swaps it
# back and pays the load once.
model="splash/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL"
timeout_min=60
notes_limit=6000
quiet_answer="Nothing to report."

nwa_ssh() {
  ssh -o UserKnownHostsFile="$nwa_known_hosts" -o StrictHostKeyChecking=accept-new \
      -o ConnectTimeout=8 -o BatchMode=yes "$nwa_host" "$@"
}

heartbeat() { # one dated line per run: check leg 5 parses these
  mkdir -p "$(dirname "$log")"
  printf '%s nwa-health %s\n' "$(date '+%Y-%m-%d %H:%M')" "$1" >>"$log"
  if [ "$(wc -l <"$log")" -gt 250 ]; then
    tail -n 200 "$log" >"$log.tmp" && mv "$log.tmp" "$log"
  fi
}

##### run -- preflight, the sandboxed agent, the archive ######################

archive() {
  local rc=$?
  local run f
  run="$state/runs/$(date -r "$(cat "$state/started" 2>/dev/null || date +%s)" +%F_%H%M)"
  mkdir -p "$run"
  for f in result skipped quiet summary.md agent.err; do
    [ -e "$state/$f" ] && cp -p "$state/$f" "$run/"
  done
  [ -e "$draft" ] && cp -p "$draft" "$run/"
  [ -e "$notes" ] && cp -p "$notes" "$run/"
  find "$state/runs" -mindepth 1 -maxdepth 1 -mtime +30 -exec rm -rf {} + 2>/dev/null
  if [ -e "$state/skipped" ]; then
    heartbeat "skipped: $(head -c 120 "$state/skipped" | tr '\n' ' ')"
  elif [ "$(cut -d' ' -f1 "$state/result" 2>/dev/null)" = success ]; then
    heartbeat "ok: $(grep -m1 -v '^[[:space:]]*$' "$state/summary.md" 2>/dev/null | head -c 120)"
  else
    heartbeat "failed: $(cat "$state/result" 2>/dev/null || echo "no result (killed) rc=$rc")"
  fi
}

run_job() {
  mkdir -p "$state/runs"
  trap archive EXIT
  rm -f "$state"/{skipped,quiet,summary.md,result,agent.err,killed}
  date +%s >"$state/started"

  # Preflight. The repo probe separates missing from unreadable (TCC on
  # ~/Documents denies the launchd job where the terminal is allowed).
  if [ ! -d "$nix_repo" ]; then
    echo "nixos-config repo missing at $nix_repo -- clone it or move the job's context elsewhere" \
      >"$state/skipped"
    exit 0
  fi
  repo_probe=$(ls "$nix_repo" 2>&1 >/dev/null)
  case $repo_probe in
    *"Operation not permitted"*)
      echo "nixos-config unreadable: Operation not permitted on $nix_repo -- TCC denies the launchd job ~/Documents (grant FDA to /bin/bash, or move the repo)" \
        >"$state/skipped"
      exit 0 ;;
  esac
  if [ ! -r "$profile_base" ]; then
    echo "no nwa-omp profile at $profile_base -- run mise run dev-agents" \
      >"$state/skipped"
    exit 0
  fi
  if ! nc -z -w 5 "$nwa_host" 22 >/dev/null 2>&1; then
    echo "nwa not reachable on port 22 ($nwa_host) -- box down or Tailscale asleep" \
      >"$state/skipped"
    exit 0
  fi

  # The job's nono profile, generated from the installed nwa-omp profile so
  # it cannot drift: ssh survives (the point of the port), the flake repo is
  # granted READ with exactly two files writable. No network key -- under
  # wrap nothing could enforce one, and none could carry ssh (#12).
  jq \
    --arg name "omp-job-nwa-health" \
    --arg repo "$nix_repo" \
    --arg notes "$notes" \
    --arg draft "$draft" '
    .meta.name = $name
    | .meta.description = "nwa-health job: ssh-capable probes over Tailscale SSH, repo read-only except notes and draft"
    | .workdir = { "access": "read" }
    | .filesystem.read = ((.filesystem.read // []) + [$repo])
    | .filesystem.allow_file = ((.filesystem.allow_file // []) + [$notes, $draft])
  ' "$profile_base" >"$profile_out" || exit 1
  nono profile validate "$profile_out" >/dev/null || {
    echo "the generated job profile does not validate" >"$state/skipped"; exit 1; }

  # The sandboxed omp needs what the interactive wrappers export: the tool
  # PATH (shell configs are denied), the Bun cache under the granted ~/.omp,
  # a granted temp home.
  PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
  export PATH
  TMPDIR="$HOME/.cache/nono-tmp/omp"
  mkdir -p "$TMPDIR"; export TMPDIR
  export BUN_INSTALL_CACHE_DIR="$HOME/.omp/cache/bun-install"

  local prompt
  prompt="$(cat "$repo/agent-jobs/nwa-health.md")

## Notes size

Keep \`health-notes.md\` under ${notes_limit} characters: it is read at the
start of every run. Merge and shorten entries; no run log -- the single
'Last run' line only. Probe mechanics you learned belong in the Environment
section of the notes, or better, propose them to the user for the brief.

## Clock

Started at $(date +%H:%M). You are killed at $(date -v+"${timeout_min}"M +%H:%M),
and anything unsaved is lost. Check \`date\` at the start of each sweep step.
Have the report ready by $(date -v+"$((timeout_min - 10))"M +%H:%M).

Keep a draft of the report, in the same final format, in \`${draft}\`.
Update it after each sweep step. If you are killed, the draft is sent instead.

If there is nothing to report, your entire last message is: ${quiet_answer}"

  cd "$work" || {
    echo "cannot enter the work dir $work" >>"$state/skipped"; exit 0; }
  rm -f "$draft"
  nono wrap --allow-cwd --profile "$profile_out" -- \
    /usr/local/bin/omp-unsandboxed -p --no-session --approval-mode=yolo \
    --model "$model" "$prompt" \
    >"$state/summary.md" 2>"$state/agent.err" &
  local job=$! elapsed=0 limit=$((timeout_min * 60)) rc=0
  # launchd has no TimeoutStartSec: this loop is the kill switch. A marker
  # file keeps a timeout distinguishable from a crash in the report.
  while kill -0 "$job" 2>/dev/null && [ "$elapsed" -lt "$limit" ]; do
    sleep 10; elapsed=$((elapsed + 10))
  done
  if kill -0 "$job" 2>/dev/null; then
    : >"$state/killed"
    kill -TERM "$job" 2>/dev/null
    sleep 30
    kill -KILL "$job" 2>/dev/null
  fi
  wait "$job"; rc=$?

  if [ -e "$state/killed" ]; then
    echo "timeout $rc" >"$state/result"
  elif [ "$rc" -eq 0 ]; then
    echo "success $rc" >"$state/result"
    rm -f "$draft"
  else
    echo "failed $rc" >"$state/result"
  fi
  exit "$rc"
}

##### seed -- copy the notes over from nwa, once ##############################

seed() {
  if [ ! -d "$nix_repo" ]; then
    echo "nixos-config repo missing at $nix_repo" >&2; exit 1
  fi
  if [ -s "$notes" ]; then
    echo "notes already exist at $notes ($(wc -c <"$notes") bytes); not overwriting -- delete it first to re-seed" >&2
    exit 1
  fi
  mkdir -p "$state"
  if nwa_ssh "cat /var/lib/agent-jobs/nwa-health/work/health-notes.md" >"$notes" 2>/dev/null \
     && [ -s "$notes" ]; then
    echo "seeded $(wc -c <"$notes") characters into $notes"
    return 0
  fi
  rm -f "$notes"
  cat >&2 <<EOF
nwa's notes file is not readable as dolf. Seed it once by hand:
  ssh -t $nwa_host 'sudo cat /var/lib/agent-jobs/nwa-health/work/health-notes.md' > "$notes"
EOF
  exit 1
}

##### report -- the ntfy notification mirror of nwa's report unit #############

report() {
  if [ ! -d "$state" ]; then
    echo "No state directory at $state -- the job has never run; mise run nwa-health" >&2
    exit 1
  fi
  cd "$state" || exit 1
  local attention="" quiet="" finished="" ran=""
  local run="" failures recovered="" msg="" notes_err="" title="" priority=3

  if [ ! -e started ] || [ $(( $(date +%s) - $(<started) )) -gt 86400 ]; then
    run="did not run in the last 24 hours"; attention=1
  elif launchctl print "gui/$(id -u)/dev.mise.nwa-health" 2>/dev/null \
      | grep -q 'state = running'; then
    run="still running"; attention=1
  elif [ -e quiet ]; then
    run="nothing to do ($(head -c 300 quiet))"; quiet=1
  elif [ -s skipped ]; then
    run="skipped: $(head -c 300 skipped)"; attention=1
  elif [ "$(cut -d' ' -f1 result 2>/dev/null)" = success ]; then
    run="finished"; finished=1; ran=1
    first=$(grep -m1 -v '^[[:space:]]*$' summary.md 2>/dev/null | tr -d '[:space:]*')
    [ "$first" = "Nothingtoreport." ] && quiet=1
  else
    run="failed ($(cat result 2>/dev/null || echo "no result"))"; attention=1; ran=1
  fi

  # A run that keeps failing notifies loudly once, then quietly, and once
  # more when it recovers.
  failures=$(cat failures 2>/dev/null || echo 0)
  if [ -n "$attention" ]; then
    failures=$((failures + 1)); echo "$failures" >failures
    [ "$failures" -gt 1 ] && run="$run; $failures runs in a row"
  elif [ "${failures:-0}" -gt 0 ]; then
    run="$run; recovered after $failures failed runs"; recovered=1
    rm -f failures
    failures=0
  fi

  msg="**Run:** $run"

  # Small models say they updated a file without doing it.
  if [ -n "$ran" ]; then
    if [ ! "$notes" -nt started ]; then
      notes_err="not rewritten in this run"
    elif [ "$(wc -c <"$notes" 2>/dev/null || echo 0)" -gt "$notes_limit" ]; then
      notes_err="$(wc -c <"$notes") characters, over the limit of $notes_limit"
    fi
    [ -n "$notes_err" ] && msg="$msg"$'\n\n'"**Notes:** $notes_err"
  fi

  if [ -n "$quiet" ] && [ -z "$attention" ] && [ -z "$recovered" ] && [ -z "$notes_err" ]; then
    echo "$msg"
    echo "Nothing to report; no notification."
    exit 0
  fi

  if [ -s summary.md ] && [ -n "$finished" ]; then
    msg="$msg"$'\n\n'"**Agent:**"$'\n'"$(head -c 2000 summary.md)"
  elif [ -s "$draft" ] && [ "$draft" -nt started ]; then
    msg="$msg"$'\n\n'"**Agent's draft (unfinished):**"$'\n'"$(head -c 2000 "$draft")"
  fi

  if [ "${failures:-0}" -gt 1 ]; then
    title="nwa-health: still failing"; priority=2
  elif [ -n "$attention" ]; then
    title="nwa-health: needs attention"; priority=4
  else
    title="nwa-health"; priority=3
  fi

  if [ "${NWA_HEALTH_DRYRUN:-}" = 1 ]; then
    printf 'dry-run (title: %s, priority: %s):\n%s\n' "$title" "$priority" "$msg"
    exit 0
  fi
  if [ ! -r "$ntfy_file" ]; then
    echo "no ntfy topic at $ntfy_file -- copy it from nwa (sops secret ntfy_topic)" >&2
    exit 1
  fi
  printf '%s' "$msg" | head -c 3900 | curl -fsS \
    -H "Title: $title" -H "Priority: $priority" -H "Markdown: yes" \
    --data-binary @- \
    "https://ntfy.sh/$(<"$ntfy_file")"
}

case "${1:-run}" in
  run) run_job ;;
  report) report ;;
  seed) seed ;;
  *) echo "usage: mise run nwa-health [run|report|seed]" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
#MISE tags=["gza"]
# The external probe of nwa (brief: agent-jobs/nwa-health.md). An omp run on
# gza probes nwa over Tailscale SSH (read-only, change nothing); a second leg
# reports over ntfy.
#
#   mise run nwa-health            the agent run  (agent: dev.mise.nwa-health)
#   mise run nwa-health report     the ntfy report (agent: dev.mise.nwa-health-report)
#   mise run nwa-health seed       copy health-notes.md from nwa
#   mise run nwa-health profile    the generated job profile, for the eye
#
# The state machine, the archive, the heartbeat, the watchdog and the report
# live in mise-tasks/_agent-job.sh. What is specific to monitoring another
# machine:
#
# - The probes run over ssh. The daily sandbox denies /usr/bin/ssh
#   (dev-agents invariant 11), so this job is the nwa-omp shape: `nono wrap`
#   on a profile generated from the installed
#   /usr/local/etc/nono/nwa-omp.json, where ssh lives. No network allow-list:
#   a domain proxy cannot carry ssh (nolabs-ai/nono#756), so under wrap the
#   filesystem grants are the whole sandbox: workdir READ, exactly two files
#   WRITE (invariant 12).
# - The work dir is ~/Documents/code/nixos-config, nwa's own flake repo; the
#   agent loads its AGENTS.md as context. The notes and the draft sit at the
#   repo root; both must stay gitignored in that repo.
# - Preflight: the harness repo probe separates missing from TCC-unreadable,
#   and nwa:22 must answer -- a down box is a skip with a reason, not a
#   failed run full of timeouts.
# - Run 06:13, report 12:03; timeout 60 min. The model is the pool's
#   flash-next behind llama-swap; an eviction by another client's pick costs
#   the job one swapped-back load, like ha-monitor.
# - The report leg is unsandboxed plain bash, the only piece that posts to
#   ntfy; the shared topic file is ~/.local/state/agent-jobs/ntfy_topic.
#
# The first real run needs the notes: seed them with `mise run nwa-health
# seed`; a run without notes treats every open problem as new.

set -uo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "nwa-health is macOS-only (launchd clocks, nono sandbox); skipping."
  exit 0
fi

repo="$HOME/.config/mise"
# shellcheck source=mise-tasks/_agent-job.sh
. "$(dirname "$0")/_agent-job.sh"

job_name="nwa-health"
nix_repo="$HOME/Documents/code/nixos-config"
repo_label="nixos-config repo"
repo_dir="$nix_repo"
state="$HOME/.local/state/agent-jobs/nwa-health"
work="$nix_repo"
notes="$work/health-notes.md"
draft="$work/report-draft.md"
ntfy_file="$HOME/.local/state/agent-jobs/ntfy_topic"
log="$HOME/Library/Logs/nwa-health.log"
# The ssh-capable base, installed by dev-agents -- the job profile derives
# from the installed file, exactly like the nwa-omp wrapper runs it.
profile_base="/usr/local/etc/nono/nwa-omp.json"
nono_mode="wrap"
nwa_host="nwa.foxhound-insen.ts.net"
nwa_known_hosts="$HOME/.omp/profiles/nwa/known_hosts"
# The splash-fn model, pinned like ha-monitor. Single-tenant behind llama-swap:
# another client's pick can evict the engine; the job's next request swaps it
# back and pays the load once.
model="splash/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL"
timeout_min=60
notes_limit=6000
quiet_answer="Nothing to report."
quiet_norm="Nothingtoreport."
usage_extra="|seed"

nwa_ssh() {
  ssh -o UserKnownHostsFile="$nwa_known_hosts" -o StrictHostKeyChecking=accept-new \
      -o ConnectTimeout=8 -o BatchMode=yes "$nwa_host" "$@"
}

job_preflight() {
  if [ ! -r "$profile_base" ]; then
    echo "no nwa-omp profile at $profile_base -- run mise run dev-agents" \
      >"$state/skipped"
    exit 0
  fi
  if ! nc -z -w 5 "$nwa_host" 22 >/dev/null 2>&1; then
    echo "nwa not reachable on port 22 ($nwa_host) -- box down or Tailscale asleep" \
      >"$state/skipped"
    exit 0
  fi
}

# Generated from the installed nwa-omp profile so it cannot drift: ssh
# survives (the point of this shape), the flake repo is granted READ with
# exactly two files writable. No network key -- under wrap nothing could
# enforce one, and none could carry ssh (invariant 12).
job_profile() {
  jq \
    --arg name "omp-job-nwa-health" \
    --arg repo "$nix_repo" \
    --arg notes "$notes" \
    --arg draft "$draft" '
    .meta.name = $name
    | .meta.description = "nwa-health job: ssh-capable probes over Tailscale SSH, repo read-only except notes and draft"
    | .workdir = { "access": "read" }
    | .filesystem.read = ((.filesystem.read // []) + [$repo])
    | .filesystem.allow_file = ((.filesystem.allow_file // []) + [$notes, $draft])
  ' "$profile_base"
}

##### seed -- copy the notes over from nwa ####################################

seed() {
  if [ ! -d "$nix_repo" ]; then
    echo "nixos-config repo missing at $nix_repo" >&2; exit 1
  fi
  if [ -s "$notes" ]; then
    echo "notes already exist at $notes ($(wc -c <"$notes") bytes); not overwriting -- delete it first to re-seed" >&2
    exit 1
  fi
  mkdir -p "$state"
  if nwa_ssh "cat /var/lib/agent-jobs/nwa-health/work/health-notes.md" >"$notes" 2>/dev/null \
     && [ -s "$notes" ]; then
    echo "seeded $(wc -c <"$notes") characters into $notes"
    return 0
  fi
  rm -f "$notes"
  cat >&2 <<EOF
nwa's notes file is not readable as dolf. Seed it once by hand:
  ssh -t $nwa_host 'sudo cat /var/lib/agent-jobs/nwa-health/work/health-notes.md' > "$notes"
EOF
  exit 1
}

job_prompt() {
  cat "$repo/agent-jobs/nwa-health.md"

  cat <<EOF

## Notes size

Keep \`health-notes.md\` under ${notes_limit} characters: it is read at the
start of every run. Merge and shorten entries; no run log -- the single
'Last run' line only. Probe mechanics you learned belong in the Environment
section of the notes, or better, propose them to the user for the brief.

## Clock

Started at $(date +%H:%M). You are killed at $(date -v+"${timeout_min}"M +%H:%M),
and anything unsaved is lost. Check \`date\` at the start of each sweep step.
Have the report ready by $(date -v+"$((timeout_min - 10))"M +%H:%M).

Keep a draft of the report, in the same final format, in \`${draft}\`.
Update it after each sweep step. If you are killed, the draft is sent instead.

If there is nothing to report, your entire last message is: ${quiet_answer}
EOF
}

case "${1:-run}" in
  seed) seed ;;
  *) agent_main "$@" ;;
esac

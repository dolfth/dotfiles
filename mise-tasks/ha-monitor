#!/usr/bin/env bash
#MISE tags=["gza"]
# The HA health check: an omp run reads Home Assistant through the read-only
# MCP server (agent-jobs/ha-monitor.md); an unsandboxed leg reports over ntfy.
#
#   mise run ha-monitor            the agent run  (agent: dev.mise.ha-monitor)
#   mise run ha-monitor report     the ntfy report (agent: dev.mise.ha-monitor-report)
#   mise run ha-monitor profile    the generated job profile, for the eye
#
# Harness: mise-tasks/_agent-job.sh; clocks: the two calendar LaunchAgents
# in mise.gza.toml (04:38 / 12:03). Work dir is the HA repo -- its AGENTS.md
# and .omp/mcp.json are the context; the generated profile grants the repo
# read and two files write, so a chatty model cannot touch deployables.
# `nono run` enforces: supervised, the allow-list filters (invariant 8);
# network is the HA host plus the model ports. Secrets are plain files: the
# repo's .ha_token (missing: skip with a reason) and the shared ntfy topic
# (missing: the report leg fails loudly).
#
# "Did not run in the last 24 hours" right after install just means the
# clock has not reached 04:38: seed it with `mise run ha-monitor`.

set -uo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "ha-monitor is macOS-only (launchd clocks, nono sandbox); skipping."
  exit 0
fi

repo="$HOME/.config/mise"
# shellcheck source=mise-tasks/_agent-job.sh
. "$(dirname "$0")/_agent-job.sh"

job_name="ha-monitor"
ha_repo="$HOME/code/homeassistant"
# The address lives outside the repo, like the API keys; preflight skips
# with a hint when the file is absent. nwa's HA repo .env is its source.
ha_host="$(cat "$HOME/.config/ha/host" 2>/dev/null || true)"
ha_url="http://${ha_host}:8123"
repo_label="HA repo"
repo_dir="$ha_repo"
state="$HOME/.local/state/agent-jobs/ha-monitor"
work="$ha_repo"
notes="$work/monitor-notes.md"
draft="$work/report-draft.md"
token="$work/.ha_token"
ntfy_file="$HOME/.local/state/agent-jobs/ntfy_topic"
log="$HOME/Library/Logs/ha-monitor.log"
# The splash-fn model. The pool is single-tenant behind llama-swap: another
# client's model pick can evict this engine mid-run, and the job's next
# request swaps it back, paying the 111 GB load once. Switching the job's
# model stays a deliberate edit.
model="splash/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL"
timeout_min=90
notes_limit=6000
quiet_answer="Nothing to report."
quiet_norm="Nothingtoreport."

job_preflight() { agent_ha_preflight; }

# Supervised `nono run` enforces the domain allow-list. The context repo is
# granted read, with exactly two files writable.
job_profile() {
  jq \
    --arg name "omp-job-ha-monitor" \
    --arg ha "$ha_host" \
    --arg venv "$state/venv" \
    --arg repo "$ha_repo" \
    --arg notes "$notes" \
    --arg draft "$draft" '
    .meta.name = $name
    | .workdir = { "access": "read" }
    | .network = { "allow_domain": [$ha], "open_port": [9292] }
    | .filesystem.read = ((.filesystem.read // []) + [$repo, $venv])
    | .filesystem.allow_file = ((.filesystem.allow_file // []) + [$notes, $draft])
    | .filesystem.deny += ["$HOME/.tsk"]
  ' "$repo/nono/omp.json"
}

job_setup() {
  # The WebSocket API (registries, repairs, traces) needs websockets; pypi is
  # outside the run's allow-list, so the venv is built here, unsandboxed.
  if [ ! -x "$state/venv/bin/python" ]; then
    if ! uv venv --quiet "$state/venv" \
      || ! uv pip install --quiet --python "$state/venv/bin/python" websockets; then
      echo "could not build the websockets venv" >"$state/skipped"
      exit 1
    fi
  fi
  export HA_URL="$ha_url" HA_PY="$state/venv/bin/python"
}

job_prompt() {
  cat "$repo/agent-jobs/ha-monitor.md"

  cat <<EOF

## Notes size

Keep \`monitor-notes.md\` under ${notes_limit} characters: it is read at the
start of every run. Merge and shorten entries; no run log -- the single
'Last run' line only. API mechanics you learned belong in the Environment
section of the notes, or better, propose them to the user for this task file.

## Clock

Started at $(date +%H:%M). You are killed at $(date -v+"${timeout_min}"M +%H:%M),
and anything unsaved is lost. Check \`date\` at the start of each sweep step.
Have the report ready by $(date -v+"$((timeout_min - 10))"M +%H:%M).

Keep a draft of the report, in the same final format, in \`${draft}\`.
Update it after each sweep step. If you are killed, the draft is sent instead.

If there is nothing to report, your entire last message is: ${quiet_answer}

## API gotchas (verified, do not rediscover)

- WS registries: \`config/device_registry/list\`, \`config/entity_registry/list\`,
  \`repairs/list_issues\`, \`config_entries/get\`. \`/api/error_log\` is gone (404)
  -> \`system_log__get_entries\`.
- \`trace/list\`: \`{"domain":"automation","item_id":"<id>"}\` (string, one id);
  \`trace/get\` adds \`run_id\`; \`result.trace\` is dict path->list, timestamps
  are \`{start, finish}\`.
- \`/api/\` answers 200 before integrations are warm after a restart: fresh
  boot + silent log = wait and re-check, not 'healthy'.
EOF
}

agent_main "${1:-run}"

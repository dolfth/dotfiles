#!/usr/bin/env bash
# The VS Code (vscodium) extensions the laptop uses. Mise has no VS Code
# marketplace backend (checked in 2026.10.14: `vscode:` is not a valid
# plugin name, and the mise registry has no such entry), so this list is
# the manifest. Runs from a final hook on every bootstrap; installing an
# already-present extension is a quick no-op, so that is acceptable.
set -uo pipefail   # no -e: one failed extension shouldn't abort the bootstrap

if ! command -v codium >/dev/null 2>&1; then
  echo "vscodium not installed -- skipping extension install."
  exit 0
fi

echo "==> Installing VS Code extensions"
for ext in \
  jeanp413.open-remote-ssh \
  ms-python.python \
  charliermarsh.ruff \
  yzhang.markdown-all-in-one; do
  codium --install-extension "$ext" || echo "  ${ext}: install failed"
done

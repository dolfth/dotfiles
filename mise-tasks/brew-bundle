#!/usr/bin/env bash
#MISE tags=["macos"]
# brew bundle --no-upgrade installs what is missing without touching what is
# present (upgrades are up's job). A failed entry warns and continues so the
# bootstrap still deploys dotfiles and agents.
set -euo pipefail

# shellcheck source=mise-tasks/_path.sh
. "$(dirname "${BASH_SOURCE[0]}")/_path.sh"

if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
files=("$REPO/Brewfile")
h="$(host_id)"
if [ -n "$h" ] && [ -f "$REPO/Brewfile.$h" ]; then
  files+=("$REPO/Brewfile.$h")
fi
# brew bundle reads exactly one --file (a repeated flag does not accumulate
# -- the last one wins), so the manifest is the concatenation of the files.
manifest="$(mktemp)"
trap 'rm -f "$manifest"' EXIT
cat "${files[@]}" > "$manifest"
# Bound the call: brew bundle can block silently on a stalled backend (a wedged
# `mas install`); the warning path below only fires on a fast failure. The
# watchdog uses the kill builtin only (pkill -P hangs in subshells here); a
# stalled mas child is orphaned but harmless.
brew bundle --no-upgrade --file="$manifest" &
bundle_pid=$!
# exec, so the subshell IS sleep: a surviving sleep would hold the task's
# stdout open and make any piping consumer wait the full 30 minutes.
( exec sleep 1800 ) &
watchdog=$!
set +e
wait "$bundle_pid"
rc=$?
set -e
kill "$watchdog" 2>/dev/null || true
wait "$watchdog" 2>/dev/null || true
if [ "$rc" -eq 0 ]; then
  echo "brew bundle: all Brewfile entries installed"
else
  echo "WARNING: brew bundle failed or was cut off at 30 minutes (rc=$rc); the bootstrap continues (dotfiles and agents still deploy)." >&2
  echo "If it stalled on an App Store app, sign in to the App Store (the missing ids are listed below), then re-run in a terminal:" >&2
  echo "  cat ${files[*]} > /tmp/Brewfile.all && brew bundle --no-upgrade --file=/tmp/Brewfile.all" >&2
fi
# mas entries fail silently when the user is not signed in or an app is missing from
# purchase history. Diff the manifest against `mas list` so the gaps get reported.
expected="$(grep -E '^mas "' "$manifest" | sed 's/^mas "\(.*\)", id: \([0-9]*\).*/\2/' | sort)"
if [ -n "$expected" ] && command -v mas >/dev/null 2>&1; then
  installed="$(mas list 2>/dev/null | awk '{print $1}' | sort)"
  missing=""
  for id in $expected; do
    echo "$installed" | grep -q "^${id}$" || missing="$missing  $id"
  done
  if [ -n "$missing" ]; then
    echo "NOTE: these App Store apps could not be installed -- ensure you're" >&2
    echo "signed in and they appear in your purchase history:" >&2
    echo "$missing" >&2
  fi
fi

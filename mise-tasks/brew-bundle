#!/usr/bin/env bash
# brew is a hard dependency of the Mac flow -- the Homebrew install is
# bootstrap step 3 (see README, "Why brew + mise") -- and the bootstrap
# installs mise from brew on a fresh machine before it runs. Re-runs on
# every bootstrap; cheap when nothing is missing.
#
# brew bundle --no-upgrade: current Homebrew's plain `brew bundle` also
# upgrades installed entries; with the flag it installs what is missing and
# does not touch what is present -- upgrades are `up`'s job. A failed entry
# (a flaky download) does not abort the bootstrap: the dotfiles, agents and
# defaults deploy anyway, and the server LaunchAgents retry their binary
# under KeepAlive once a manual `brew bundle` finishes.
set -euo pipefail
if [ "$(uname -s)" != "Darwin" ]; then
  exit 0
fi
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
files=("$REPO/Brewfile")
if [ -n "${HOST:-}" ] && [ -f "$REPO/Brewfile.$HOST" ]; then
  files+=("$REPO/Brewfile.$HOST")
fi
# brew bundle reads exactly one --file (a repeated flag does not accumulate
# -- the last one wins), so the manifest is the concatenation of the files.
manifest="$(mktemp)"
trap 'rm -f "$manifest"' EXIT
cat "${files[@]}" > "$manifest"
if brew bundle --no-upgrade --file="$manifest"; then
  echo "brew bundle: all Brewfile entries installed"
else
  echo "WARNING: brew bundle reported failures; the bootstrap continues (dotfiles and agents still deploy)." >&2
  echo "Re-run in a terminal:" >&2
  echo "  cat ${files[*]} > /tmp/Brewfile.all && brew bundle --no-upgrade --file=/tmp/Brewfile.all" >&2
fi
# App Store apps (mas entries in Brewfile.<host>) are silent failures when
# the user is not signed in or the app is missing from purchase history.
# Diff the Brewfile against mas list and surface any gaps so the user can
# act on them instead of wondering why the apps are missing.
if [ -f "$REPO/Brewfile.mca" ]; then
  expected="$(grep -E '^mas "' "$REPO/Brewfile.mca" | sed 's/^mas "\(.*\)" .*/\1/' | sort)"
  if command -v mas >/dev/null 2>&1; then
    installed="$(mas list 2>/dev/null | awk '{print $1}' | sort)"
    missing=""
    for id in $expected; do
      [ -n "$(echo "$installed" | grep "^${id}$")" ] || missing="$missing  $id"
    done
    if [ -n "$missing" ]; then
      echo "NOTE: these App Store apps could not be installed -- ensure you're" >&2
      echo "signed in and they appear in your purchase history:" >&2
      echo "$missing" >&2
    fi
  fi
fi

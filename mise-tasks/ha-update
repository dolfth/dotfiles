#!/usr/bin/env bash
#MISE tags=["gza"]
# The HA updater. An omp run installs pending Home Assistant updates over the
# API (agent-jobs/ha-update.md); a second leg reports the outcome over ntfy.
#
#   mise run ha-update            the agent run  (agent: dev.mise.ha-update)
#   mise run ha-update report     the ntfy report (agent: dev.mise.ha-update-report)
#   mise run ha-update profile    the generated job profile, for the eye
#
# The state machine, the archive, the heartbeat, the watchdog and the report
# live in mise-tasks/_agent-job.sh. What differs from the ha-monitor pattern:
#
# - Weekly clock: run Fri 02:33, report Fri 06:03 -- 90 min of run plus
#   restart margin before the report reads the state. The report's stale
#   window is 8 days, not 24 h: a weekly job is not dead at 25 h.
# - No websockets venv: everything this job does is REST.
# - Secrets identical: the HA repo's .ha_token and the shared ntfy topic.
# - No cross-run notes file: the agent writes the report draft and nothing
#   else.
# - This job mutates HA: the network allow-list (HA and the model ports only)
#   is the write guard, and the draft-after-each-install rule makes a killed
#   run's report name exactly where the work stopped.
#
# A run that reports "did not run in the last 8 days" right after install
# means Friday has not come yet: seed it with `mise run ha-update`.

set -uo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "ha-update is macOS-only (launchd clocks, nono sandbox); skipping."
  exit 0
fi

repo="$HOME/.config/mise"
# shellcheck source=mise-tasks/_agent-job.sh
. "$(dirname "$0")/_agent-job.sh"

job_name="ha-update"
ha_repo="$HOME/Documents/code/homeassistant"
ha_host="192.168.0.253"
ha_url="http://${ha_host}:8123"
repo_label="HA repo"
repo_dir="$ha_repo"
state="$HOME/.local/state/agent-jobs/ha-update"
work="$ha_repo"
draft="$work/update-report-draft.md"
token="$work/.ha_token"
ntfy_file="$HOME/.local/state/agent-jobs/ntfy_topic"
log="$HOME/Library/Logs/ha-update.log"
# The splash-fn model, pinned like ha-monitor's. The pool is single-tenant
# behind llama-swap: another client's pick can evict the engine mid-run, and
# the job's next request swaps it back, paying the load once -- switching the
# job's model stays a deliberate edit.
model="splash/unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL"
timeout_min=90
stale_days=8
quiet_answer="No updates needed."
quiet_norm="Noupdatesneeded."

job_preflight() { agent_ha_preflight; }

# Supervised `nono run` enforces the domain allow-list. The repo is read --
# the agent's context and token -- with exactly one file writable: the
# report draft. The write guard is the network: only HA and the model are
# reachable at all.
job_profile() {
  jq \
    --arg name "omp-job-ha-update" \
    --arg ha "$ha_host" \
    --arg repo "$ha_repo" \
    --arg draft "$draft" '
    .meta.name = $name
    | .workdir = { "access": "read" }
    | .network = { "allow_domain": [$ha], "open_port": [9292] }
    | .filesystem.read = ((.filesystem.read // []) + [$repo])
    | .filesystem.allow_file = ((.filesystem.allow_file // []) + [$draft])
    | .filesystem.deny += ["$HOME/.tsk"]
  ' "$repo/nono/omp.json"
}

job_setup() {
  export HA_URL="$ha_url"
}

job_prompt() {
  cat "$repo/agent-jobs/ha-update.md"

  cat <<EOF

## Clock

Started at $(date +%H:%M). You are killed at $(date -v+"${timeout_min}"M +%H:%M),
and anything unsaved is lost. Check \`date\` before each install.
Have the report ready by $(date -v+"$((timeout_min - 10))"M +%H:%M).

Keep a draft of the report, in the same final format, in \`${draft}\`.
Update it after each install. If you are killed, the draft is sent instead --
which is also why the job installs one update at a time: the draft then names
exactly where the work stopped.

If there is nothing to report, your entire last message is: ${quiet_answer}

## API gotcha (verified, do not rediscover)

- \`/api/\` answers 200 before integrations are warm after a restart: one
  extra minute between 'API back' and the state comparison prevents a
  false 'unavailable -> stop'.
EOF
}

agent_main "${1:-run}"

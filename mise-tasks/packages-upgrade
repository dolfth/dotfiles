#!/usr/bin/env bash
# Upgrades the brew formulae mise manages, for the `up` fish function.
#
# Named instead of `mise bootstrap packages upgrade` (everything): the full
# run resolves every configured formula -- including the installed ones, to
# compare versions -- and the current mise release cannot evaluate the omlx,
# splash and omp tap definitions (their formulas use constructs the brew
# shims lack -- see the omlx-splash task and the gza module), so a full run
# dies on them. Name what works instead: every resolvable formula of the
# Mac modules. Keep this list in sync with those modules when the package
# lists change. The three server/agent formulae stay out on purpose:
# omlx and splash are the omlx-splash task's (MISE_OMLX_SPLASH_FORCE=1
# upgrades them), and omp is the `up` function's brew bridge block (its
# with_env install step is unsupported by mise's shim).
set -euo pipefail

[ "$(uname -s)" = "Darwin" ] || exit 0

mise bootstrap packages upgrade \
  brew:bat brew:duckdb brew:dust brew:exiftool brew:ffmpeg brew:fish \
  brew:git brew:git-delta brew:htop brew:jq brew:mas brew:mole brew:mosh \
  brew:neovim brew:python@3.14 brew:ruby brew:starship brew:uv brew:mise \

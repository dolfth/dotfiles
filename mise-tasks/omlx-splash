#!/usr/bin/env bash
# Installs the two tap formulae the current mise release cannot evaluate --
# jundot/omlx and incoai/tap/splash -- into the Homebrew prefix in the layout
# their formulae produce, so the dev.mise.* LaunchAgents have something to run
# on a fresh machine.
#
# Why a task and not `mise bootstrap packages apply`: mise's brew manager
# evaluates tap definitions that publish no API metadata with a Ruby shim,
# and mise 2026.10.14's shim chokes on the `MacOS` constant omlx uses and the
# `Requirement` class splash uses, so neither resolves. File a mise issue with
# the reproducer below; when the fix ships, delete this task and the
# pre-packages hook line that calls it.
#   reproducer: a config with [bootstrap.brew.taps] jundot/omlx +
#   incoai/tap, [bootstrap.packages] = "latest" for both, then
#   `mise bootstrap packages apply` on a machine without the kegs.
# The task reproduces the formulae's install steps by hand, downloading the
# same release artifacts the formulae name, so it tracks upstream releases the
# way `brew install` would.
#
# Self-guarding: the base pre-packages hook runs this on every host, but it
# acts only where the active config declares jundot/omlx/omlx -- that is gza.
# On mca and nwa it exits after the uname check (or one `mise bootstrap plan`
# call on mca).
#
# Idempotent: a keg already linked into opt/ (brew-installed on an existing
# machine, or written by an earlier run of this task) is left alone. mise's
# prefix scan counts a linked Cellar directory as installed either way, so
# `apply` and `status` stay quiet afterwards. To upgrade on a machine without
# Homebrew, re-run with MISE_OMLX_SPLASH_FORCE=1 (it replaces the kegs); on a
# machine with Homebrew, `brew upgrade omlx splash` does it (see up.fish).

set -euo pipefail

[ "$(uname -s)" = "Darwin" ] || exit 0

# Only gza declares omlx; skip the plan call and all work everywhere else.
plan="$(mise bootstrap plan --json 2>/dev/null || true)"
if ! printf '%s' "$plan" | grep -q '"brew:jundot/omlx/omlx"'; then
  exit 0
fi

PREFIX="${MISE_BREW_PREFIX:-/opt/homebrew}"
FORCE="${MISE_OMLX_SPLASH_FORCE:-0}"
OMLX_RB="https://raw.githubusercontent.com/jundot/omlx/HEAD/Formula/omlx.rb"
SPLASH_RB="https://raw.githubusercontent.com/incoai/homebrew-tap/HEAD/Formula/splash.rb"

# The packages step creates the prefix itself, but this task runs in
# pre-packages, before it. Create it the way Homebrew does -- owned by the
# user, so mise and a later brew can both write into it without sudo.
if [ ! -d "$PREFIX/Cellar" ]; then
  echo "==> Creating $PREFIX"
  sudo mkdir -p "$PREFIX"/{bin,lib,libexec,include,share,Cellar,opt,etc,var}
  sudo chown -R "$(id -u):$(id -g)" "$PREFIX"
fi

# brew-compatible receipt: a later Homebrew sees the keg as its own.
receipt() { # <name> <version> <formula-file>
  local dir="$PREFIX/Cellar/$1/$2/.brew"
  mkdir -p "$dir"
  cp "$3" "$dir/$1.rb"
  printf '%s\n' "$PREFIX" > "$dir/path.txt"
  printf '{ "install_time": %s, "runtime_dependencies": [], "build_dependencies": [] }\n' \
    "$(date +%s)" > "$dir/installed.json"
  printf '{ "path": "%s" }\n' "$PREFIX" > "$PREFIX/Cellar/$1/$2/INSTALL_RECEIPT.json"
}

link() { # <name> <version>
  ln -sfn "../Cellar/$1/$2" "$PREFIX/opt/$1"
}

installed() { # <name>: linked opt/<name> pointing at a real keg directory
  [ -L "$PREFIX/opt/$1" ] && [ -d "$PREFIX/opt/$1" ]
}


install_splash() {
  [ "$(uname -m)" = "arm64" ] || { echo "splash: arm64 only, skipping" >&2; return 0; }
  # The formula requires macOS 26.4 or newer (its Requirement).
  local ver
  ver="$(sw_vers -productVersion)"
  [ "$(printf '%s\n26.4\n' "$ver" | sort -V | head -n1)" = "26.4" ] ||
    { echo "splash: requires macOS 26.4, this is $ver, skipping" >&2; return 0; }

  local rb url sha name keg
  rb="$(mktemp)"
  curl -fsSL "$SPLASH_RB" -o "$rb"
  url="$(sed -n 's/^[[:space:]]*url "\(.*\)"$/\1/p' "$rb" | head -n1)"
  sha="$(sed -n 's/^[[:space:]]*sha256 "\(.*\)"$/\1/p' "$rb" | head -n1)"
  name="$(basename "$url" | sed -E 's/^splash-//; s/-(arm64|x86_64)-macos[0-9.]+\.tar\.gz$//')"

  echo "==> splash: $name from $url"
  keg="$PREFIX/Cellar/splash/$name"
  if [ "$FORCE" = 1 ]; then
    rm -rf "$keg" "$PREFIX/opt/splash" "$PREFIX/bin/splash"
  fi
  mkdir -p "$keg/libexec" "$keg/bin"
  local tmp; tmp="$(mktemp)"
  curl -fL "$url" -o "$tmp"
  if [ -n "$sha" ]; then
    (cd "$(dirname "$tmp")" && echo "$sha  $(basename "$tmp")" | shasum -a 256 -c -)
  fi
  # The release tarball is a self-contained engine (it bundles its own
  # python); the formula installs its contents as libexec/.
  tar -xzf "$tmp" --strip-components 1 -C "$keg/libexec"
  rm -f "$tmp"

  # The formula's bin/splash shim (the #{opt_libexec} path expanded).
  cat > "$keg/bin/splash" <<SH
#!/bin/sh
export PYTHONDONTWRITEBYTECODE=1
exec "$PREFIX/opt/splash/libexec/python/bin/python3" -u "$PREFIX/opt/splash/libexec/install/launcher.py" "\$@"
SH
  chmod 0755 "$keg/bin/splash"

  # Completions, as the formula installs them.
  mkdir -p "$PREFIX/share/fish/vendor_completions.d" \
           "$PREFIX/share/zsh/site-functions" \
           "$PREFIX/etc/bash_completion.d"
  [ -f "$keg/libexec/install/completions/splash.fish" ] &&
    ln -sfn "../Cellar/splash/$name/libexec/install/completions/splash.fish" "$PREFIX/share/fish/vendor_completions.d/splash.fish"
  [ -f "$keg/libexec/install/completions/_splash" ] &&
    ln -sfn "../Cellar/splash/$name/libexec/install/completions/_splash" "$PREFIX/share/zsh/site-functions/_splash"
  [ -f "$keg/libexec/install/completions/splash.bash" ] &&
    ln -sfn "../Cellar/splash/$name/libexec/install/completions/splash.bash" "$PREFIX/etc/bash_completion.d/splash"

  ln -sfn "../Cellar/splash/$name/bin/splash" "$PREFIX/bin/splash"
  link splash "$name"
  receipt splash "$name" "$rb"
  rm -f "$rb"
}

install_omlx() {
  local rb url sha tag ver keg
  rb="$(mktemp)"
  curl -fsSL "$OMLX_RB" -o "$rb"
  url="$(sed -n 's/^[[:space:]]*url "\(.*\)"$/\1/p' "$rb" | head -n1)"
  sha="$(sed -n 's/^[[:space:]]*sha256 "\(.*\)"$/\1/p' "$rb" | head -n1)"
  tag="$(basename "$url" | sed -E 's/\.tar\.gz$//')"          # v0.7.1rc1
  ver="${tag#v}"                                               # 0.7.1rc1

  echo "==> omlx: $ver from $url"
  keg="$PREFIX/Cellar/omlx/$ver"
  if [ "$FORCE" = 1 ]; then
    rm -rf "$keg" "$PREFIX/opt/omlx" "$PREFIX/bin/omlx"
  fi
  mkdir -p "$keg/bin"

  # The venv's base python. The formula builds against python3.11 (its
  # requires-python is >=3.11,<3.14); mise's own python is declared in the
  # gza module's [tools], so it is never pruned. The system python is 3.9,
  # too old; brew's python@3.11 is the fallback where it exists (an
  # existing machine is a no-op anyway, so this only matters on a fresh one).
  local py=""
  mise install python@3.11 >/dev/null
  local d
  for d in "${MISE_DATA_DIR:-$HOME/.local/share/mise}"/installs/python/3.11.*/bin/python3.11; do
    [ -x "$d" ] && py="$d" && break
  done
  if [ -z "$py" ] && [ -x "$PREFIX/opt/python@3.11/bin/python3.11" ]; then
    py="$PREFIX/opt/python@3.11/bin/python3.11"
  fi
  if [ -z "$py" ]; then
    echo "omlx: no usable python 3.11-3.13 found; run 'mise install python@3.11'" >&2
    return 1
  fi

  "$py" -m venv "$keg/libexec"

  # The pip install is a plain one (wheels), not the formula's: the formula
  # force-builds four deps from source only so Homebrew can rewrite their
  # install names, which a keg at a fixed path never needs. Wheels exist for
  # all of them (macos arm64, cp311-313).
  local build tmp
  build="$(mktemp -d)"
  tmp="$build/omlx.tar.gz"
  curl -fL "$url" -o "$tmp"
  if [ -n "$sha" ]; then
    (cd "$build" && echo "$sha  omlx.tar.gz" | shasum -a 256 -c -)
  fi
  mkdir "$build/src"
  tar -xzf "$tmp" --strip-components 1 -C "$build/src"

  "$keg/libexec/bin/pip" install -q "$build/src"

  # The formula's mlx-audio resource: a git rev with the mlx-lm pin relaxed
  # to avoid a conflict. If the formula bumps either, bump them here.
  local audio="$build/mlx-audio"
  git clone -q https://github.com/Blaizzy/mlx-audio "$audio"
  git -C "$audio" checkout -q 51753266e0a4f766fd5e6fbc46652224efc23981
  sed -i '' 's/"mlx-lm==0.31.1"/"mlx-lm>=0.31.1"/' "$audio/pyproject.toml"
  "$keg/libexec/bin/pip" install -q "$audio[all]"

  # The formula's spaCy model resource (Kokoro TTS G2P); keep in sync with
  # the formula's en-core-web-sm resource.
  local spacy="$build/en_core_web_sm-3.8.0-py3-none-any.whl"
  curl -fsSL "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl" -o "$spacy"
  (cd "$build" && echo "1932429db727d4bff3deed6b34cfc05df17794f4a52eeb26cf8928f7c1a0fb85  en_core_web_sm-3.8.0-py3-none-any.whl" | shasum -a 256 -c -)
  "$keg/libexec/bin/pip" install -q --no-deps "$spacy"
  "$keg/libexec/bin/python" -c "import spacy; spacy.load('en_core_web_sm')"

  # python-multipart is declared in omlx's [audio] extra, not in mlx-audio.
  "$keg/libexec/bin/pip" install -q "python-multipart>=0.0.5"

  # The venv's console script, exactly as the formula links it.
  ln -sfn "../libexec/bin/omlx" "$keg/bin/omlx"
  ln -sfn "../Cellar/omlx/$ver/bin/omlx" "$PREFIX/bin/omlx"
  link omlx "$ver"
  receipt omlx "$ver" "$rb"
  rm -rf "$build" "$rb"

  "$keg/bin/omlx" --version >/dev/null 2>&1 ||
    echo "omlx: installed, but 'omlx --version' failed; check the LaunchAgent log" >&2
}

# The dispatch, after both installs are defined. FORCE replaces the kegs
# (the upgrade path on a machine without Homebrew); without it an existing
# keg -- brew- or task-installed -- is left alone.
if installed splash; then
  if [ "$FORCE" = 1 ]; then
    install_splash
  else
    echo "splash: already installed, skipping (MISE_OMLX_SPLASH_FORCE=1 to replace)"
  fi
else
  install_splash
fi

if installed omlx; then
  if [ "$FORCE" = 1 ]; then
    install_omlx
  else
    echo "omlx: already installed, skipping (MISE_OMLX_SPLASH_FORCE=1 to replace)"
  fi
else
  install_omlx
fi

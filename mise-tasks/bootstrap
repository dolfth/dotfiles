#!/usr/bin/env bash
#MISE tags=["macos"]
# LaunchAgent self-heal. Runs after macos-launchd-agents rewrites plists:
# bootstrap loads any not-yet-loaded job, kickstart any loaded-but-dead one
# (no-op on a healthy agent; never kills a running server). No-op off macOS
# and wherever the agents are not declared.

set -uo pipefail   # no -e: one agent failing must not abort the other

if [ "$(uname -s)" != "Darwin" ]; then
  echo "agent self-heal is macOS-only; skipping."
  exit 0
fi

gui="gui/$(id -u)"
# A job whose binary is missing can never reach the running state and launchctl blocks
# on its transitions. Bound each call so one broken agent cannot wedge the bootstrap;
# without `timeout`, the call runs unbounded.
if command -v timeout >/dev/null 2>&1; then
  lc() { timeout 15 launchctl "$@"; }
else
  lc() { launchctl "$@"; }
fi
for agent in dev.mise.omlx dev.mise.llama-swap dev.mise.pin-check \
             dev.mise.ha-monitor dev.mise.ha-monitor-report \
             dev.mise.ha-update dev.mise.ha-update-report \
             dev.mise.nwa-health dev.mise.nwa-health-report; do
  plist="${HOME}/Library/LaunchAgents/${agent}.plist"
  if [ ! -f "$plist" ]; then
    continue   # agents not declared on this machine (the gza module owns them)
  fi
  # A scheduled agent must always be loaded -- launchd fires the calendar
  # time only for a loaded job -- but must never be kickstarted: a manual
  # start outside the schedule would fake a heartbeat.
  if plutil -extract StartCalendarInterval xml1 -o - "$plist" 2>/dev/null | grep -q "<dict>"; then
    lc bootstrap "$gui" "$plist" 2>/dev/null || true
    echo "  ${agent}: scheduled; (re)loaded, not started"
    continue
  fi
  # No RunAtLoad means on demand by design (omlx: out of the GPU pool, started by
  # hand); self-healing it resurrects what the operator just took down.
  if ! plutil -extract RunAtLoad raw "$plist" 2>/dev/null | grep -qx true; then
    echo "  ${agent}: on demand; left alone (its own task starts it)"
    continue
  fi
  lc bootstrap "$gui" "$plist" 2>/dev/null || true
  lc kickstart "$gui/$agent" 2>/dev/null || echo "  ${agent}: kickstart failed or timed out (missing binary? check the brew-bundle warnings above)" >&2
done

# The ha-monitor state tree. Its first run would create it too, but the
# secrets are copied before that run, so the target dirs must already exist.
if [ -f "${HOME}/Library/LaunchAgents/dev.mise.ha-monitor.plist" ]; then
  mkdir -p "${HOME}/.local/state/agent-jobs/ha-monitor/work"
  echo "  ha-monitor: state tree at ~/.local/state/agent-jobs/ha-monitor"
fi
if [ -f "${HOME}/Library/LaunchAgents/dev.mise.ha-update.plist" ]; then
  mkdir -p "${HOME}/.local/state/agent-jobs/ha-update"
  echo "  ha-update: state tree at ~/.local/state/agent-jobs/ha-update"
fi
if [ -f "${HOME}/Library/LaunchAgents/dev.mise.nwa-health.plist" ]; then
  mkdir -p "${HOME}/.local/state/agent-jobs/nwa-health"
  echo "  nwa-health: state tree at ~/.local/state/agent-jobs/nwa-health"
fi
# The llama-swap API key, outside the repo. Seeded before any template can use
# it (notes/services.md); on a fresh gza that ordering misses the first
# apply, so a second bootstrap renders the key into llama-swap's config and
# omp's catalog -- same re-run story as the miserc seed.
if [ -f "${HOME}/Library/LaunchAgents/dev.mise.llama-swap.plist" ]; then
  if [ ! -s "${HOME}/.config/llama-swap/api_key" ]; then
    mkdir -p "${HOME}/.config/llama-swap"
    (umask 077 && printf 'sk-%s\n' "$(openssl rand -hex 32)" >"${HOME}/.config/llama-swap/api_key")
    echo "  llama-swap: API key seeded at ~/.config/llama-swap/api_key"
  fi
fi

# Report without touching: a port still held by another process (an interactive `splash
# serve` in a terminal, blocking the front door's preload) is left to its owner --
# KeepAlive picks the agent up when that process exits.
for pair in "omlx:8080" "llama-swap:9292"; do
  name="${pair%%:*}"
  port="${pair#*:}"
  pid=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1)
  if [ -n "$pid" ] && [ -f "${HOME}/Library/LaunchAgents/dev.mise.${name}.plist" ]; then
    owner=$(ps -o comm= -p "$pid" 2>/dev/null || echo "?")
    # `launchctl print` renders the line "pid = N": fields "pid", "=", "N".
    jobpid=$(launchctl print "$gui/dev.mise.${name}" 2>/dev/null | awk '$1 == "pid" {print $3; exit}')
    if [ -n "${jobpid:-}" ] && [ "$pid" = "$jobpid" ]; then
      echo "  ${name}: agent owns port ${port}"
    else
      echo "  ${name}: port ${port} held by ${owner} (pid ${pid}); the agent will take over when it exits"
    fi
  fi
done

echo "agent self-heal done (logs: ~/Library/Logs/omlx.log, ~/Library/Logs/llama-swap.log)"

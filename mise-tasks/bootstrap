#!/usr/bin/env bash
#MISE tags=["macos"]
# LaunchAgent self-heal. Runs after macos-launchd-agents rewrites plists:
# bootstrap loads any not-yet-loaded job, kickstart any loaded-but-dead one
# (no-op on a healthy agent; never kills a running server). No-op off macOS
# and wherever the agents are not declared.

set -uo pipefail   # no -e: one agent failing must not abort the other

if [ "$(uname -s)" != "Darwin" ]; then
  echo "agent self-heal is macOS-only; skipping."
  exit 0
fi

gui="gui/$(id -u)"
# A job whose binary is missing can never reach the running state, and
# launchctl blocks on its transitions -- a dead omlx once hung this task for
# hours. Bound each call so one broken agent cannot wedge the bootstrap;
# without `timeout` on the box, the call runs unbounded as before.
if command -v timeout >/dev/null 2>&1; then
  lc() { timeout 15 launchctl "$@"; }
else
  lc() { launchctl "$@"; }
fi
for agent in dev.mise.omlx dev.mise.splash dev.mise.splash-fn dev.mise.pin-check; do
  plist="${HOME}/Library/LaunchAgents/${agent}.plist"
  if [ ! -f "$plist" ]; then
    continue   # agents not declared on this machine (the gza module owns them)
  fi
  # A scheduled agent must always be loaded -- launchd fires the calendar
  # time only for a loaded job -- but must never be kickstarted: a manual
  # start outside the schedule would fake a heartbeat.
  if plutil -extract StartCalendarInterval xml1 -o - "$plist" 2>/dev/null | grep -q "<dict>"; then
    lc bootstrap "$gui" "$plist" 2>/dev/null || true
    echo "  ${agent}: scheduled; (re)loaded, not started"
    continue
  fi
  # An agent without RunAtLoad is on demand by design (the 27B and omlx: one
  # GPU pool tenant at a time, switched by `mise run gpupool`); self-healing
  # it would resurrect what the operator just took down.
  if ! plutil -extract RunAtLoad raw "$plist" 2>/dev/null | grep -qx true; then
    echo "  ${agent}: on demand; left alone (its own task starts it)"
    continue
  fi
  lc bootstrap "$gui" "$plist" 2>/dev/null || true
  lc kickstart "$gui/$agent" 2>/dev/null || echo "  ${agent}: kickstart failed or timed out (missing binary? check the brew-bundle warnings above)" >&2
done

# Report without touching: a port still held by another process (an
# interactive `splash serve` in a terminal, say) is left to its owner -- the
# agent picks it up on its own under KeepAlive when that process exits.
for pair in "omlx:8080" "splash:8000" "splash-fn:8100"; do
  name="${pair%%:*}"
  port="${pair#*:}"
  pid=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1)
  if [ -n "$pid" ] && [ -f "${HOME}/Library/LaunchAgents/dev.mise.${name}.plist" ]; then
    owner=$(ps -o comm= -p "$pid" 2>/dev/null || echo "?")
    # `launchctl print` renders the line "pid = N": fields "pid", "=", "N".
    jobpid=$(launchctl print "$gui/dev.mise.${name}" 2>/dev/null | awk '$1 == "pid" {print $3; exit}')
    if [ -n "${jobpid:-}" ] && [ "$pid" = "$jobpid" ]; then
      echo "  ${name}: agent owns port ${port}"
    else
      echo "  ${name}: port ${port} held by ${owner} (pid ${pid}); the agent will take over when it exits"
    fi
  fi
done

echo "agent self-heal done (logs: ~/Library/Logs/omlx.log, ~/Library/Logs/splash.log, ~/Library/Logs/splash-fn.log)"

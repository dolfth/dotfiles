#!/usr/bin/env bash
# LaunchAgent self-heal + port report.
#
# For each dev.mise.* agent this machine declared, the loop runs (both
# branches verified against a throwaway agent on 2026-10-19):
#
#   launchctl bootstrap || true -- (re)loads a job whose plist exists but is
#     not loaded (a bare kickstart cannot find it: "Could not find service");
#     a suppressed no-op error when the job is already loaded. The plist
#     itself is mise's: the macos-launchd-agents part (it runs before this
#     task) re-writes and reloads the job when its definition changes.
#
#   launchctl kickstart         -- starts a loaded-but-dead agent, and is a
#     no-op on a healthy one (same pid before and after; the same rule mise's
#     own launchd code follows -- a killed-and-respawned process can wait out
#     ThrottleInterval). So a bootstrap never kills a running server or drops
#     a session talking to it. Version-driven restarts after a keg upgrade
#     live in `up`, which compares the opt link and kicks with -k on purpose.
#
# Safe everywhere: no-op off macOS and wherever the agents are not declared
# (mca, nwa) -- the plists are only written on gza.

set -uo pipefail   # no -e: one agent failing must not abort the other

if [ "$(uname -s)" != "Darwin" ]; then
  echo "agent self-heal is macOS-only; skipping."
  exit 0
fi

gui="gui/$(id -u)"
for agent in dev.mise.omlx dev.mise.splash; do
  plist="${HOME}/Library/LaunchAgents/${agent}.plist"
  if [ ! -f "$plist" ]; then
    continue   # agents not declared on this machine (the gza module owns them)
  fi
  launchctl bootstrap "$gui" "$plist" 2>/dev/null || true
  launchctl kickstart "$gui/$agent" 2>/dev/null || true
done

# Report without touching: a port still held by another process (an
# interactive `splash serve` in a terminal, say) is left to its owner -- the
# agent picks it up on its own under KeepAlive when that process exits.
for pair in "omlx:8080" "splash:8000"; do
  name="${pair%%:*}"
  port="${pair#*:}"
  pid=$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -1)
  if [ -n "$pid" ] && [ -f "${HOME}/Library/LaunchAgents/dev.mise.${name}.plist" ]; then
    owner=$(ps -o comm= -p "$pid" 2>/dev/null || echo "?")
    # `launchctl print` renders the line "pid = N": fields "pid", "=", "N".
    jobpid=$(launchctl print "$gui/dev.mise.${name}" 2>/dev/null | awk '$1 == "pid" {print $3; exit}')
    if [ -n "${jobpid:-}" ] && [ "$pid" = "$jobpid" ]; then
      echo "  ${name}: agent owns port ${port}"
    else
      echo "  ${name}: port ${port} held by ${owner} (pid ${pid}); the agent will take over when it exits"
    fi
  fi
done

echo "agent self-heal done (logs: ~/Library/Logs/omlx.log, ~/Library/Logs/splash.log)"

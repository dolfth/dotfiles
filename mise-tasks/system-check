#!/usr/bin/env bash
#MISE tags=["macos"]
# Runs from the bootstrap final hook. The user-level parts apply without
# sudo; the system part is TTY-gated so an unattended bootstrap skips it
# instead of hanging on a password prompt.

set -uo pipefail   # no -e before sudo: some commands fail naturally (defaults, killall)

if [ "$(uname -s)" != "Darwin" ]; then
  echo "system-check is macOS-only; skipping."
  exit 0
fi

##### Sandboxed app defaults (need Full Disk Access) ##########################
#
# Sandboxed apps (Mail, TextEdit, Displays, Safari) keep their domain in a
# container only FDA can write; reading the TCC db needs the same, hence the probe.
fda=1
if ! head -c1 "/Library/Application Support/com.apple.TCC/TCC.db" >/dev/null 2>&1; then
  fda=
  echo "==> No Full Disk Access (e.g. over SSH): skipping Mail, Safari, TextEdit and Displays defaults"
fi

if [ -n "$fda" ]; then
  # Mail: attachments as icons; no reply/send animations
  defaults write com.apple.mail DisableInlineAttachmentViewing -bool true
  defaults write com.apple.mail DisableReplyAnimations -bool true
  defaults write com.apple.mail DisableSendAnimations -bool true
  # Copy just the address, not "Name <addr>"
  defaults write com.apple.mail AddressesIncludeNameOnPasteboard -bool false
  # Cmd+Enter sends (@ = Cmd, \U21a9 = return); dict-add keeps the other keys
  defaults write com.apple.mail NSUserKeyEquivalents -dict-add "Send" "@\U21a9"
  # Drafts threaded, newest first
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "DisplayInThreadedMode" -string "yes"
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortedDescending" -string "yes"
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortOrder" -string "received-date"
  # TextEdit: plain text, UTF-8 (4) in and out
  defaults write com.apple.TextEdit RichText -int 0
  defaults write com.apple.TextEdit PlainTextEncoding -int 4
  defaults write com.apple.TextEdit PlainTextEncodingForWrite -int 4
  # Displays: show the display list in Displays settings
  defaults write com.apple.Displays-Settings.extension showListByDefault -int 2
  # Safari: its engine id is container-scoped, so it cannot be declared like
  # the system preference in mise.toml. A failing defaults domain aborts
  # the whole bootstrap, which is why it sits behind the FDA guard.
  defaults write com.apple.Safari DefaultBrowserSearchProviderIdentifier -string com.duckduckgo
fi

# Finder: new windows open Home. $USER interpolates here, not in declarative
# defaults.
defaults write com.apple.finder NewWindowTargetPath -string "file:///$USER/"

# Dock: the Downloads tile. Folder tiles live in persistent-others, which mise's
# dock.apps never touches, and a tile needs $HOME plus binary data. It must be a
# directory-tile with an unscoped `book` bookmark; a file-tile, or a bookmark-less
# tile, renders "?". Those bytes come from no public creation option, so this
# compares shape, not bytes: an existing directory-tile is left alone, a
# file-tile or absent one is replaced. The Dock dies only if something was
# written -- a restart rebuilds Spaces.
dock_rc=0
timeout 90 swift -suppress-warnings - <<'EOF' || dock_rc=$?
import Foundation
let home = FileManager.default.homeDirectoryForCurrentUser.standardizedFileURL
let dl = home.appendingPathComponent("Downloads")
let key = "persistent-others" as CFString
let dock = "com.apple.dock" as CFString
func tileDict(_ t: Any) -> [String: Any]? { (t as? [String: Any])?["tile-data"] as? [String: Any] }
func tileURL(_ t: Any) -> URL? {
    guard let fd = tileDict(t)?["file-data"] as? [String: Any],
          let s = fd["_CFURLString"] as? String else { return nil }
    return URL(string: s)?.standardizedFileURL
}
func isOurs(_ t: Any) -> Bool { tileURL(t)?.path == dl.path }
let others = (CFPreferencesCopyAppValue(key, dock) as? [Any]) ?? []
if let ours = others.first(where: isOurs),
   (ours as? [String: Any])?["tile-type"] as? String == "directory-tile" {
    exit(0)   // a Dock-made tile (dragged or healed earlier): hands off
}
guard let bm = try? dl.bookmarkData(options: [.withoutImplicitSecurityScope])
else {
    print("  Dock: no bookmark for \(dl.path); Downloads tile left as it was")
    exit(1)
}
// microsecond ticks since 1970 -- the unit the Dock's own tile stores
func macEpoch(_ u: URL) -> Int64 {
    let d = (try? u.resourceValues(forKeys: [.contentModificationDateKey]))?
        .contentModificationDate ?? Date(timeIntervalSince1970: 0)
    return Int64(d.timeIntervalSince1970 * 1e6)
}
var updated = others.filter { !isOurs($0) }
updated.append([
    "GUID": Int(arc4random()),
    "tile-type": "directory-tile",
    "tile-data": [
        "book": bm,
        "file-data": ["_CFURLString": dl.absoluteString,
                      "_CFURLStringType": 15],
        "file-label": "Downloads",
        "file-type": 2,
        "file-mod-date": macEpoch(dl),
        "parent-mod-date": macEpoch(dl.deletingLastPathComponent()),
        "arrangement": 1, "displayas": 0, "showas": 0,
        "preferreditemsize": -1, "is-beta": false,
    ],
] as [String: Any])
CFPreferencesSetAppValue(key, updated as NSArray, dock)
CFPreferencesAppSynchronize(dock)
print("  Dock: wrote the Downloads directory-tile")
exit(13)
EOF
[ "$dock_rc" = 127 ] && echo "  Dock: swift unavailable; Downloads tile skipped"
if [ "$dock_rc" = 13 ]; then
  killall Dock >/dev/null 2>&1 || echo "  Dock: restart failed; the tile appears when the Dock next starts"
fi

# Menu bar: the Bluetooth item -- an int in the per-host controlcenter domain
# (2 = shown), read by the snapshot's -currentHost export. Volume stays manual:
# its state lives in per-machine NSKeyedArchiver blobs keyed by UUID.
defaults -currentHost write com.apple.controlcenter Bluetooth -int 2

# Manual light or dark mode conflicts with the automatic switch (declarative
# in mise.toml); `defaults delete` exits 1 when the key is already gone.
if defaults read NSGlobalDomain AppleInterfaceStyle >/dev/null 2>&1; then
  defaults delete NSGlobalDomain AppleInterfaceStyle
fi

chflags nohidden "${HOME}/Library" 2>/dev/null || true

##### UI restart (only when a domain they read changed) ######################
#
# Killing Dock and WindowManager rebuilds Spaces and makes AeroSpace re-tile,
# so only restart them if the defaults bootstrap just wrote actually changed
# shellcheck source=mise-tasks/_defaults.sh
source "$(dirname "${BASH_SOURCE[0]}")/_defaults.sh"

before_file="${TMPDIR:-/tmp}/mise-defaults-snapshot"
if [ -f "$before_file" ] && [ "$(snap | shasum | awk '{print $1}')" != "$(cat "$before_file" 2>/dev/null)" ]; then
  # Flush cfprefsd and reload settings, so most apply without a logout.
  killall cfprefsd 2>/dev/null || true
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true
  # Most settings are read only at launch.
  for app in Dock Finder SystemUIServer ControlCenter WindowManager; do
    killall "$app" >/dev/null 2>&1 || true
  done
fi

##### LinearMouse login item (the one non-scriptable UI step) #################
#
# "Start at Login" lives in the private login-items (BTM) store, written only by
# the app's own toggle -- not linearmouse.json, not defaults. The item survives
# reboots and reinstalls, so it is one step per machine, and launching the app
# registers nothing. So this only reminds, when the app is there and the item is
# not.
if [ "$(uname -s)" = "Darwin" ] && [ -d /Applications/LinearMouse.app ] \
  && ! sfltool dumpbtm 2>/dev/null | grep -q "com.lujjjh.LinearMouse"; then
  echo "  LinearMouse is not set to start at login: open it and tick 'Start at Login'"
fi

##### Sudo part (TTY-gated) ###################################################

if [ ! -t 0 ]; then
  echo "==> Skipping system settings (no TTY; run 'mise run system-check' in a terminal)"
  exit 0
fi

echo "==> System settings (sudo required)"
sudo -v || { echo "No sudo; skipping."; exit 0; }
set -eo pipefail   # after sudo succeeds: abort on real failures

##### Touch ID for sudo #######################################################
#
# Enable the line Apple ships in sudo_local.template; write it directly if
# a future macOS has no template.

if [ ! -f /etc/pam.d/sudo_local ]; then
  if [ -f /etc/pam.d/sudo_local.template ]; then
    sudo sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  else
    printf 'auth       sufficient     pam_tid.so\n' \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  fi
  echo "  Touch ID for sudo enabled"
fi

##### Firewall ################################################################
#
# Block unsolicited inbound connections; stealth mode ignores probes.

sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on >/dev/null
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on >/dev/null

# Block ALL inbound (breaks file sharing, AirDrop, SSH):
# sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setblockall on >/dev/null

##### MagicDNS in /etc/resolv.conf ############################################
#
# Programs that read the file (bun, Go without cgo) never see the Tailscale
# supplemental resolver, so MagicDNS names return ENOTFOUND for them. Newer
# clients rewrite the file; declaring it survives an older client or an OS rewrite.
if ! grep -q '^nameserver 100\.100\.100\.100' /etc/resolv.conf 2>/dev/null; then
  sudo tee /etc/resolv.conf >/dev/null <<'EOF'
search foxhound-insen.ts.net localdomain
nameserver 100.100.100.100
nameserver fd7a:115c:a1e0::53
EOF
  echo "  /etc/resolv.conf: added the tailnet resolvers (file-reading programs can see MagicDNS)"
fi

##### Power management ########################################################
#
# By the host module's KIND (laptop | desktop); unknown hosts get the laptop
# profile.

case "${KIND:-laptop}" in
  desktop)
    # Always-on desktop: only the display sleeps; no standby, hibernation, Power
    # Nap or Low Power Mode; autorestart after a power cut.
    sudo pmset -a sleep 0 disksleep 0 standby 0 hibernatemode 0 \
      powernap 0 lowpowermode 0 displaysleep 15 autorestart 1 \
      womp 1 tcpkeepalive 1
    # "Start up when power is connected" (macOS 26.5+): Mac mini 2024+, Studio
    # 2025+, iMac 2024+ only, not MDM-manageable, pmset the only scripted way.
    # Unsupported hosts reject the key, so warn rather than abort.
    if ! sudo pmset autorestartatconnect 1; then
      echo "  'Start up when power is connected' unavailable here (needs Mac mini 2024+ / Mac Studio 2025+ / iMac 2024+ on macOS 26.5+): set it in System Settings > Energy"
    fi
    ;;
  *)
    # Laptop: sleep when idle, sooner on battery than on AC.
    sudo pmset -b sleep 5 displaysleep 5 disksleep 10 standby 1 powernap 0
    sudo pmset -c sleep 10 displaysleep 10 disksleep 10 powernap 0
    ;;
esac
# Lock on wake: pmset has no such setting; the stock default already asks.

##### Hostname ################################################################
# All names set to HOST (the module var), else the current hostname.
H="${HOST:-$(scutil --get ComputerName)}"
sudo scutil --set ComputerName "$H"
sudo scutil --set HostName "$H"
sudo scutil --set LocalHostName "$H"
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server \
  NetBIOSName -string "$H"

##### Software Update #########################################################
#
# Check, never download or install unasked; install by hand:
# `softwareupdate -l` / `-i <label>`. Security stays automatic through
# ConfigDataInstall (XProtect, Gatekeeper, no restart) and CriticalUpdateInstall
# (Rapid Security Responses, a short restart at most) -- point releases count as
# macOS updates, security-only ones included, so the install switch stays off.
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true

if [ "${KIND:-laptop}" = "desktop" ]; then

  ##### GPU wired memory ######################################################
  #
  # The GPU-wired cap sets the model size omlx can load. One pool for every GPU
  # user and nothing refused below it, so a cap near RAM freezes the machine when
  # the pool fills. WIRED_LIMIT_MB (gza module) leaves the host room; the sysctl
  # resets at boot, so a LaunchDaemon reapplies it.
  W="${WIRED_LIMIT_MB:?WIRED_LIMIT_MB is not set; add it to the gza module}"
  WIRED="sysctl -w iogpu.wired_limit_mb=${W}"
  sudo tee /Library/LaunchDaemons/dev.mise.wired-limit.plist >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mise.wired-limit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>$WIRED</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF
  sudo launchctl bootout system/dev.mise.wired-limit 2>/dev/null || true
  sudo launchctl bootstrap system /Library/LaunchDaemons/dev.mise.wired-limit.plist 2>/dev/null || true
  sudo sh -c "$WIRED" >/dev/null

  ##### Screen Sharing ########################################################
  #
  # bootout first: bootstrap no-ops on a loaded job, so a job a macOS update left
  # disabled would never clear and every connection dies as "not permitted". If a
  # client is still denied, toggle Screen Sharing once in System Settings.
  sudo launchctl bootout system/com.apple.screensharing 2>/dev/null || true
  sudo launchctl enable system/com.apple.screensharing >/dev/null || true
  sudo launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.screensharing.plist 2>/dev/null || true
  sudo defaults write /Library/Preferences/com.apple.screensharing Disabled -bool false

  ##### Remote Login (SSH) ####################################################
  #
  # Password auth stays on for the pre-unlock sshd: on macOS 26+ ssh with the
  # account password unlocks FileVault after a power cut (man
  # apple_ssh_and_filevault). launchctl because `systemsetup` needs FDA.
  sudo launchctl enable system/com.openssh.sshd >/dev/null || true
  sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || true

fi

##### FileVault ################################################################
#
# Not automatable: `fdesetup enable` handles the recovery key interactively,
# and the key must not go to stdout.

if ! fdesetup status | grep -q "FileVault is On"; then
  echo "  FileVault is OFF. Enable it: System Settings > Privacy & Security"
fi

##### Manual checklist ########################################################
#
# Not scriptable (the TCC database is SIP-protected):
#   - Full Disk Access for the terminal (~/Library/Mail, /dev)
#   - Accessibility for window managers and hotkey tools
#   - Screen Recording for capture tools
#   - iCloud sign-in and services
#
# Plus LinearMouse "Start at Login" -- see the check above for why only the
# app's own UI toggle can set it.

echo "==> System settings applied."

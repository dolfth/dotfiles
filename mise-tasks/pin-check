#!/usr/bin/env bash
#MISE tags=["macos"]
# The pinned release URLs, probed. The three places that fetch a pinned GitHub
# release (dev-agents: the omp binary; apple-intelligence: the pared tarball +
# checksum sidecar; the luxmini task: the pinned DMG) fail the
# moment upstream removes or renames an asset, and the only way to discover
# that is to fetch it for real -- possibly during a bootstrap on the one box
# that matters. This task HEADs every pinned asset so the breakage is announced
# first.
#
# Nothing needs to watch this: the dev.mise.pin-check agent
# runs it weekly (mise.toml); every run appends one line to
# ~/Library/Logs/pin-check.log, so the log's age shows whether the agent is alive and
# `mise run check` calls a log older than 8 days dead; a failing run raises a macOS
# notification in unsandboxed agent sessions, else the exit code is the signal.
#
# Versions are read from the pin table in mise.toml [vars], the same
# table dev-agents, apple-intelligence and the luxmini task consume, so a bump
# needs no change here. A missing var fails the check: the pin moved out from
# under a consumer.

set -uo pipefail   # no -e: check every pin, report all of them

if [ "$(uname -s)" != "Darwin" ]; then
  echo "pin-check is macOS-only; skipping."
  exit 0
fi

log="$HOME/Library/Logs/pin-check.log"
failures=()
checked=0

# The pinned versions, from the config itself. A missing var means a consumer
# would fail too -- fail loudly, the pin went unchecked.
mise_vars_json=$(mise vars --json)
omp_version=$(printf '%s' "$mise_vars_json" | jq -r '.omp_version // empty')
[ -n "$omp_version" ] || failures+=("omp: no omp_version var (mise.toml)")
pared_version=$(printf '%s' "$mise_vars_json" | jq -r '.pared_version // empty')
[ -n "$pared_version" ] || failures+=("pared: no pared_version var (mise.toml)")
luxmini_version=$(printf '%s' "$mise_vars_json" | jq -r '.luxmini_version // empty')
[ -n "$luxmini_version" ] || failures+=("luxmini: no luxmini_version var (mise.toml)")

# HEAD a pinned asset; GitHub answers 404 (redirect-followed) for removed
# releases and assets alike.
probe() { # probe NAME URL
  local code
  code=$(curl -fsIL --max-time 20 -o /dev/null -w '%{http_code}' "$2" 2>/dev/null) || {
    failures+=("$1: fetch failed (${code:-curl error}) $2"); return; }
  checked=$((checked + 1))
  echo "  $1: $code $2"
}

[ -n "${omp_version:-}" ] && \
  probe "omp $omp_version" \
    "https://github.com/can1357/oh-my-pi/releases/download/v$omp_version/omp-darwin-arm64"
if [ -n "${pared_version:-}" ]; then
  pared_base="https://github.com/4evy/pared/releases/download/$pared_version/pared-macos-arm64.tar.gz"
  probe "pared $pared_version" "$pared_base"
  probe "pared $pared_version sha256" "$pared_base.sha256"
fi
# The pinned DMG's asset: the luxmini task builds the URL from the version
# into this exact URL shape, same as pared builds it from its version line.
[ -n "${luxmini_version:-}" ] && \
  probe "luxmini $luxmini_version" \
    "https://github.com/bastiencantet/luxmini-public/releases/download/v$luxmini_version/LuxMini-$luxmini_version.dmg"

# One line per run, capped: the log is also the heartbeat's liveness proof,
# so it must always exist and must never outgrow its usefulness.
ts=$(date '+%Y-%m-%d %H:%M')
if [ ${#failures[@]} -eq 0 ]; then
  line="$ts ok  $checked/$((checked + ${#failures[@]}))  omp $omp_version, pared $pared_version, luxmini $luxmini_version"
else
  line="$ts FAIL $((${#failures[@]})) of $((checked + ${#failures[@]})): $(printf '%s; ' "${failures[@]}")"
fi
printf '%s\n' "$line" >>"$log"
if [ "$(wc -l <"$log")" -gt 250 ]; then
  tail -n 200 "$log" >"$log.tmp" && mv "$log.tmp" "$log"
fi

if [ ${#failures[@]} -gt 0 ]; then
  printf '  %s\n' "${failures[@]}" >&2
  # The weekly agent runs unsandboxed in the GUI session, so the user sees
  # this; anywhere else osascript fails quietly and the exit code speaks.
  /usr/bin/osascript -e "display notification \"${failures[0]}\" with title \"pin-check: a pinned release URL broke\" sound name \"Basso\"" 2>/dev/null || true
  echo "log: $log"
  exit 1
fi
echo "all $checked pinned assets live (log: $log)"

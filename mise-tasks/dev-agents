#!/usr/bin/env bash
#MISE tags=["macos"]
# The Mac omp sandbox: nwa's dev-agents.nix ported from Landlock to
# nono/Seatbelt. Installs nono/omp.json and nono/omp-wrapper.sh under /usr/local,
# root:wheel, and checks the invariants.
#
#   mise run dev-agents          verify, then install (needs sudo)
#   mise run dev-agents check    static checks only, no sudo
#
# 1. Deny ~/.config/herdr: `herdr pane run` executes unsandboxed, so its control
#    socket is an escape.
# 2. Strip HERDR_ENV, HERDR_SOCKET_PATH and HERDR_CLIENT_SOCKET_PATH; keep
#    HERDR_AGENT, which herdr reads off the pane's foreground process.
# 3. `nono wrap`, not `run`: run's supervisor takes the foreground, so panes show
#    "unknown". local-omp wants that (#8).
# 4. --profile by full path. A registry pack can claim a name.
# 5. root:wheel outside $HOME, installed by copy: the agent must not edit its own
#    sandbox.
# 6. No grants of $HOME, ~/.ssh, or secret-manager key paths.
# 7. Documents stay shut by default-deny. A deny outranks every allow, so a
#    Documents deny would also forbid working there: Bun dies on getcwd.
# 8. local-omp (offline, sensitive) has its profile generated here from omp.json
#    plus vars.omp_base, so the two entry points cannot drift on grants. Its
#    wrapper uses `nono run` -- only supervised mode enforces a network allow-list.
#    That filter is per-host, not per-port: on gza the allow-domain is 127.0.0.1, so
#    every local port is reachable, and `network.block` would cut the model too.
# 9. The daily profile denies $HOME/.omp/profiles: local-omp keeps its sessions,
#    logs and memory there, and they must not reach a networked session.
# 10. The daily profile grants ~/.tsk, the tsk store. One store serves every repo,
#     so offline work must not reach the shared board.

set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "dev-agents is macOS-only; skipping."
  exit 0
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
profile_src="$root/nono/omp.json"
wrapper_src="$root/nono/omp-wrapper.sh"
agents_md_src="$root/nono/AGENTS-sandbox.md"
local_wrapper_src="$root/nono/local-omp-wrapper.sh"
agents_local_src="$root/nono/AGENTS-sandbox-local.md"

profile_dst=/usr/local/etc/nono/omp.json
local_profile_dst=/usr/local/etc/nono/local-omp.json
wrapper_dst=/usr/local/bin/omp
local_wrapper_dst=/usr/local/bin/local-omp
raw_dst=/usr/local/bin/omp-unsandboxed

# local-omp's state tree; invisible to the daily sandbox by the deny of #9.
local_state="$HOME/.omp/profiles/local"

# Pinned release plus checksum; the wrapper needs a path brew never touches.
omp_version="18.18.6"
omp_sha256="ed2e63eb43888eb76cb1409b245b1db4557c94dfad52dc545c9aaca01ebce82d"  # omp-darwin-arm64

fail() { echo "dev-agents check: $*" >&2; exit 1; }

# The model host: vars.omp_base, the value models.yml.tera renders too.
omp_base() {
  local base
  base="$(mise vars | awk '$1 == "omp_base" { print $2 }')"
  [ -n "$base" ] || fail "vars.omp_base not set (base mise.toml)"
  printf '%s' "$base"
}

# Generated from omp.json so the two profiles cannot drift on grants.
gen_local_profile() {
  jq --arg base "$(omp_base)" '
    .meta.name = "local-omp"
    | .meta.description = "omp offline: model host only, state isolated from the daily sandbox"
    | .filesystem.deny -= ["$HOME/.omp/profiles"]
    | .filesystem.deny += ["$HOME/.tsk"]
    | .network = { "allow_domain": [$base], "open_port": [8000, 8080, 8100] }
  ' "$profile_src"
}

##### check -- the invariants, machine-checked ################################

check() {
  # strict: installed differing from repo fails. lenient (pre-install): the
  # install below cures staleness, so refusing there would deadlock.
  local strict="${1:-strict}"
  # Inside a sandbox /usr/local/etc/nono is invisible, so an unreadable install
  # would read as "not installed yet". NONO_CAP_FILE is set by nono.
  [ -z "${NONO_CAP_FILE:-}" ] || fail "running inside a nono sandbox; the check must run unsandboxed -- run 'mise run dev-agents check' from a normal terminal"
  command -v nono >/dev/null || fail "nono not installed (Brewfile entry; run the bootstrap or brew install nono)"
  command -v jq >/dev/null || fail "jq not installed"

  # nono matches a probe at the deepest existing ancestor, so a granted path
  # that never existed reads as ungranted and the ALLOW probes below would
  # fail on a fresh machine before install_stack ever runs. Seatbelt itself
  # ignores existence; the same dirs are created again after the install.
  mkdir -p "$HOME/.tsk" "$HOME/.omp/agent" "$HOME/.omp/profiles/local/agent/memories/mnemopi"

  nono profile validate "$profile_src" >/dev/null || fail "profile does not validate"

  # R2: exactly the three herdr control vars denied.
  local vars
  vars=$(jq -r '.environment.deny_vars | sort | join(",")' "$profile_src")
  [ "$vars" = "HERDR_CLIENT_SOCKET_PATH,HERDR_ENV,HERDR_SOCKET_PATH" ] \
    || fail "environment.deny_vars is '$vars', want the three herdr control vars"

  # R1: the socket dir is denied, and the engine agrees.
  jq -e '.filesystem.deny | index("$HOME/.config/herdr")' "$profile_src" >/dev/null \
    || fail "profile does not deny \$HOME/.config/herdr"
  # No `| head -1`: the early exit SIGPIPEs nono and pipefail turns that into 141.
  local why
  why=$(nono why --profile "$profile_src" --unix-socket "$HOME/.config/herdr/sessions/check/herdr.sock" 2>&1 || true)
  case "$why" in DENIED*) ;; *) fail "nono why: herdr socket not denied (${why:-no output})" ;; esac

  # R7: documents unreachable by default-deny. $root is a neutral workdir, so a
  # repo moved under Documents fails here.
  local docs_why
  docs_why=$(nono why --profile "$profile_src" --workdir "$root" --path "$HOME/Documents" 2>&1 || true)
  case "$docs_why" in DENIED*) ;; *) fail "nono why: \$HOME/Documents not denied (${docs_why:-no output})" ;; esac

  # R8 + R9: local-omp's profile is generated, never a repo file (#8).
  local gen
  gen="$(mktemp)"
  gen_local_profile > "$gen" || fail "cannot generate local-omp profile"
  nono profile validate "$gen" >/dev/null || fail "generated local-omp profile does not validate"

  # R8: the model host answers, the remote world does not.
  local net_why remote_why
  net_why=$(nono why --profile "$gen" --host "$(omp_base)" --port 8100 2>&1 || true)
  case "$net_why" in ALLOWED*) ;; *) fail "local-omp: model host not reachable (${net_why:-no output})" ;; esac
  remote_why=$(nono why --profile "$gen" --host api.openai.com 2>&1 || true)
  case "$remote_why" in DENIED*) ;; *) fail "local-omp: remote network not denied (${remote_why:-no output})" ;; esac

  # R8 backstop: generation must not relax default-deny on documents.
  local local_docs_why
  local_docs_why=$(nono why --profile "$gen" --workdir "$root" --path "$HOME/Documents" 2>&1 || true)
  case "$local_docs_why" in DENIED*) ;; *) fail "local-omp: \$HOME/Documents not denied (${local_docs_why:-no output})" ;; esac

  # R9: the daily sandbox is blind to local state; local reads its own.
  local state_path="$local_state/agent/memories/mnemopi/mnemopi.db"
  local daily_state_why local_state_why
  daily_state_why=$(nono why --profile "$profile_src" --workdir "$root" --path "$state_path" 2>&1 || true)
  case "$daily_state_why" in DENIED*) ;; *) fail "daily omp can read local state (${daily_state_why:-no output})" ;; esac
  local_state_why=$(nono why --profile "$gen" --workdir "$root" --path "$state_path" 2>&1 || true)
  case "$local_state_why" in ALLOWED*) ;; *) fail "local-omp cannot read its own state (${local_state_why:-no output})" ;; esac

  # R10: the shared tsk store belongs to the daily sandbox alone.
  local daily_tsk_why local_tsk_why
  daily_tsk_why=$(nono why --profile "$profile_src" --workdir "$root" --path "$HOME/.tsk" 2>&1 || true)
  case "$daily_tsk_why" in ALLOWED*) ;; *) fail "daily omp cannot reach the tsk store (${daily_tsk_why:-no output})" ;; esac
  local_tsk_why=$(nono why --profile "$gen" --workdir "$root" --path "$HOME/.tsk" 2>&1 || true)
  case "$local_tsk_why" in DENIED*) ;; *) fail "local-omp can reach the tsk store (${local_tsk_why:-no output})" ;; esac

  # R6 as the engine sees it: extends and groups can grant more than these lists.
  local key_why
  key_why=$(nono why --profile "$profile_src" --path "$HOME/.ssh/id_ed25519" 2>&1 || true)
  case "$key_why" in DENIED*) ;; *) fail "nono why: \$HOME/.ssh/id_ed25519 not denied (${key_why:-no output})" ;; esac

  # R4 + R3 + R2-keep: profile by path, wrap not run, HERDR_AGENT exported.
  grep -q -- "--profile $profile_dst" "$wrapper_src" \
    || fail "wrapper does not pass --profile $profile_dst (a full path)"
  grep -q "nono wrap " "$wrapper_src" || fail "wrapper does not use 'nono wrap'"
  grep -q "export HERDR_AGENT=omp" "$wrapper_src" || fail "wrapper does not export HERDR_AGENT"
  grep -q "export BUN_INSTALL_CACHE_DIR=" "$wrapper_src" \
    || fail "wrapper does not redirect the Bun install cache (~/.bun is denied; the memory embedder dies)"

  # Same for the local wrapper, but run, not wrap: wrap hosts no proxy.
  grep -q -- "--profile $local_profile_dst" "$local_wrapper_src" \
    || fail "local wrapper does not pass --profile $local_profile_dst (a full path)"
  grep -q "nono run " "$local_wrapper_src" \
    || fail "local wrapper does not use 'nono run' (domain filtering needs the supervised proxy)"
  grep -q "export HERDR_AGENT=local-omp" "$local_wrapper_src" \
    || fail "local wrapper does not export HERDR_AGENT=local-omp"
  grep -q "export OMP_PROFILE=local" "$local_wrapper_src" \
    || fail "local wrapper does not export OMP_PROFILE=local (state isolation, #9)"

  # R9 as text: daily denies the tree, the generated profile must not.
  jq -e '.filesystem.deny | index("$HOME/.omp/profiles")' "$profile_src" >/dev/null \
    || fail "daily profile does not deny \$HOME/.omp/profiles"
  jq -e '.filesystem.deny | index("$HOME/.omp/profiles") | not' "$gen" >/dev/null \
    || fail "local-omp profile still denies its own state tree"

  # R10 as text: daily allows the store, the generated profile denies it.
  jq -e '.filesystem.allow | index("$HOME/.tsk")' "$profile_src" >/dev/null \
    || fail "daily profile does not allow \$HOME/.tsk"
  jq -e '.filesystem.deny | index("$HOME/.tsk")' "$gen" >/dev/null \
    || fail "local-omp profile does not deny the shared tsk store"

  # R6: no $HOME, ~/.ssh or secret-manager grants in either profile.
  local pf grants
  for pf in "$profile_src" "$gen"; do
    grants=$(jq -r '[.filesystem | (.allow // [])[], (.allow_file // [])[], (.read // [])[], (.read_file // [])[]] | join(" ")' "$pf")
    # Literals on purpose: they match $HOME text in the profile JSON.
    # shellcheck disable=SC2016
    for bad in '"$HOME"' '$HOME/.ssh' sops age/ '$HOME/.gnupg' '$HOME/.aws'; do
      case " $grants " in *" $bad "*) fail "$pf grants a protected path: $bad" ;; esac
    done
  done

  # R5 on the installed copies: present, current, root:wheel.
  local p
  for f in "$profile_dst" "$local_profile_dst" "$wrapper_dst" "$local_wrapper_dst" "$raw_dst"; do
    [ -e "$f" ] || { echo "  (not installed yet: $f)"; continue; }
    p=$(stat -f '%Su:%Sg' "$f")
    [ "$p" = "root:wheel" ] || fail "$f is owned by $p, want root:wheel (the agent could edit its own sandbox)"
  done

  # Staleness of every installed piece: the wrapper compares through the same
  # brew-prefix substitution, the raw binary through --version.
  local stale="" brew_prefix
  brew_prefix="$(brew --prefix 2>/dev/null || true)"
  if [ -e "$profile_dst" ] && ! cmp -s "$profile_src" "$profile_dst"; then
    stale="$profile_dst"
  fi
  if [ -e "$local_profile_dst" ] && ! cmp -s "$gen" "$local_profile_dst"; then
    stale="${stale:+$stale, }$local_profile_dst"
  fi
  if [ -n "$brew_prefix" ] && [ -e "$wrapper_dst" ] \
     && ! cmp -s <(sed "s|__BREW_PREFIX__|$brew_prefix|g" "$wrapper_src") "$wrapper_dst"; then
    stale="${stale:+$stale, }$wrapper_dst"
  fi
  if [ -n "$brew_prefix" ] && [ -e "$local_wrapper_dst" ] \
     && ! cmp -s <(sed "s|__BREW_PREFIX__|$brew_prefix|g" "$local_wrapper_src") "$local_wrapper_dst"; then
    stale="${stale:+$stale, }$local_wrapper_dst"
  fi
  if [ -e "$raw_dst" ] && ! "$raw_dst" --version 2>/dev/null | grep "$omp_version" >/dev/null; then
    stale="${stale:+$stale, }$raw_dst"
  fi
  if [ -n "$stale" ]; then
    if [ "$strict" = strict ]; then
      fail "$stale is stale; re-run mise run dev-agents"
    fi
    echo "  (stale: $stale -- the install below refreshes)"
  fi

  # The wrapper must win on PATH; a brew omp sorts first. grep reads to EOF: an
  # early exit SIGPIPEs brew and pipefail inverts the condition.
  if [ -x /opt/homebrew/bin/omp ] || [ -x "$(brew --prefix 2>/dev/null)/bin/omp" ]; then
    echo "  warning: a brew-managed omp still shadows the wrapper on PATH"
  fi

  echo "dev-agents check: OK"
}

##### install -- root-owned files, sudo, TTY-gated like system-check ##########

# NOT named `install`: bash resolves functions before binaries, so the seed
# lines below would recurse. They also say `command install`.
install_stack() {
  # TTY gate: an unattended bootstrap cannot answer a password prompt.
  if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
    echo "==> dev-agents: the /usr/local install needs sudo and no TTY is attached; run 'mise run dev-agents' from a terminal."
    return 0
  fi

  brew_prefix="$(brew --prefix)"
  [ -x "$brew_prefix/bin/nono" ] || fail "nono missing at $brew_prefix/bin/nono (brew bundle first)"

  echo "==> Installing the sandbox (root:wheel, outside \$HOME, never symlinked)"
  # /usr/local/bin may not exist yet; install stages its temp file inside it.
  sudo mkdir -p /usr/local/etc/nono /usr/local/bin
  sudo install -o root -g wheel -m 644 "$profile_src" "$profile_dst"

  # local-omp.json is generated here, not stored in the repo (#8).
  local_profile="$(mktemp)"
  gen_local_profile > "$local_profile"
  sudo install -o root -g wheel -m 644 "$local_profile" "$local_profile_dst"
  rm -f "$local_profile"

  tmp_wrapper="$(mktemp)"
  sed "s|__BREW_PREFIX__|$brew_prefix|g" "$wrapper_src" > "$tmp_wrapper"
  sudo install -o root -g wheel -m 755 "$tmp_wrapper" "$wrapper_dst"
  rm -f "$tmp_wrapper"

  tmp_wrapper="$(mktemp)"
  sed "s|__BREW_PREFIX__|$brew_prefix|g" "$local_wrapper_src" > "$tmp_wrapper"
  sudo install -o root -g wheel -m 755 "$tmp_wrapper" "$local_wrapper_dst"
  rm -f "$tmp_wrapper"

  # The pinned raw binary.
  if ! "$raw_dst" --version 2>/dev/null | grep "$omp_version" >/dev/null; then
    echo "==> Fetching omp $omp_version (pinned, checksum-verified)"
    tmp_bin="$(mktemp)"
    curl -fL --retry 3 -o "$tmp_bin" \
      "https://github.com/can1357/oh-my-pi/releases/download/v$omp_version/omp-darwin-arm64"
    echo "$omp_sha256  $tmp_bin" | shasum -a 256 -c - \
      || fail "omp binary checksum mismatch -- refusing to install"
    sudo install -o root -g wheel -m 755 "$tmp_bin" "$raw_dst"
    rm -f "$tmp_bin"
  fi

  # A brew omp on PATH sorts before /usr/local/bin and would shadow the wrapper.
  if brew list --formula 2>/dev/null | grep -x omp >/dev/null; then
    echo "==> Removing brew omp (superseded by $raw_dst)"
    brew uninstall omp
  fi

  # The dirs the profile grants; Seatbelt does not care whether they exist.
  mkdir -p "$HOME/.config/herdr" "$HOME/.omp/agent" "$HOME/.cache/nono-tmp/omp" \
           "$HOME/.local/share/uv" "$HOME/.local/bin" "$HOME/.config/git" "$HOME/.tsk"

  # git's pieces with ~/.ssh denied: the public signing key and known_hosts the
  # wrapper points git at.
  if [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
    cmp -s "$HOME/.ssh/id_ed25519.pub" "$HOME/.config/git/sign.pub" \
      || command install -m 644 "$HOME/.ssh/id_ed25519.pub" "$HOME/.config/git/sign.pub"
  fi
  if [ -f "$HOME/.ssh/known_hosts" ]; then
    cmp -s "$HOME/.ssh/known_hosts" "$HOME/.config/git/known_hosts" \
      || command install -m 644 "$HOME/.ssh/known_hosts" "$HOME/.config/git/known_hosts"
  fi

  # The sandbox note omp loads, so a denial costs one line, not an investigation.
  cmp -s "$agents_md_src" "$HOME/.omp/agent/AGENTS.md" \
    || command install -m 644 "$agents_md_src" "$HOME/.omp/agent/AGENTS.md"

  # Seed local-omp's named profile (#9): symlinks to the same rendered config and
  # caches -- runtime material only, no document content.
  mkdir -p "$local_state/tmp" "$local_state/agent"
  ln -sfn "$HOME/.omp/agent/models.yml" "$local_state/agent/models.yml"
  ln -sfn "$HOME/.omp/agent/config.yml" "$local_state/agent/config.yml"
  ln -sfn "$HOME/.omp/agent/cache" "$local_state/agent/cache"
  ln -sfn "$HOME/.omp/cache" "$local_state/cache"
  cmp -s "$agents_local_src" "$local_state/agent/AGENTS.md" \
    || command install -m 644 "$agents_local_src" "$local_state/agent/AGENTS.md"

  echo "==> Installed: $(/usr/local/bin/omp-unsandboxed --version), wrapped by $wrapper_dst and $local_wrapper_dst"
}

case "${1:-all}" in
  check) check strict ;;
  all)   check lenient; install_stack ;;
  *)     echo "usage: mise run dev-agents [check|all]"; exit 2 ;;
esac

#!/usr/bin/env bash
#MISE tags=["macos"]
# The Mac omp sandbox: the port of nwa's dev-agents.nix (NixOS, Landlock) to
# macOS (nono, Seatbelt). Installs the root-owned sandbox under /usr/local and
# checks the invariants it relies on. See nono/omp.json (profile) and
# nono/omp-wrapper.sh (wrapper) for the pieces installed.
#
#   mise run dev-agents          verify, then install (install needs sudo)
#   mise run dev-agents check    static checks only, no sudo
#
# The invariants, and why the sandbox dies without them:
#
# 1. The herdr control socket (~/.config/herdr/sessions/<name>/herdr.sock)
#    must be unreachable from inside the sandbox: `herdr pane run` executes
#    commands in UNSANDBOXED panes, so reaching the socket is an escape.
#    Seatbelt blocks connect() on sockets under a filesystem.deny path
#    (proven: EPERM there, while sockets in allowed paths still connect --
#    the block is path-specific). The check below re-asserts it via `nono why`.
# 2. HERDR_ENV, HERDR_SOCKET_PATH and HERDR_CLIENT_SOCKET_PATH are stripped
#    (environment.deny_vars) so an agent concludes "not under herdr" instead
#    of failing on the socket; HERDR_AGENT is KEPT (the wrapper exports it --
#    herdr reads it from the pane's foreground process to name the agent).
# 3. `nono wrap`, not `nono run`: run's non-dumpable supervisor becomes the
#    foreground process and herdr panes show "unknown". This is the DAILY
#    omp's constraint (it wants herdr's agent integration); local-omp
#    deliberately uses run instead -- see 8.
# 4. --profile takes a full path, never a name: names resolve at run time and
#    a registry pack can claim one (nwa watched `nono pull` replace a profile
#    with one granting ~/.claude and the network).
# 5. The profile and the wrapper are root:wheel and outside $HOME -- the
#    agent runs as this user and must not be able to edit its own sandbox.
#    They are installed by copy, never symlinked from this repo.
# 6. No grants of $HOME itself, ~/.ssh, or sops/age key paths.
# 7. Personal documents stay unreachable with NO filesystem.deny entry for
#    $HOME/Documents: a deny outranks every allow, including the workdir
#    grant, so denying Documents forbade launching sandboxed omp from a
#    workdir under it (EPERM on getcwd, Bun dies at startup). Default-deny
#    keeps it shut; the check re-asserts that from a neutral workdir.
# 8. local-omp (sensitive work, offline): its profile is NOT a repo file.
#    It is generated here from omp.json + vars.omp_base (gen_local_profile),
#    so the two entry points cannot drift on filesystem grants; they differ
#    only by name, the deny carve-out of #9, and a network allow-list of the
#    model host (vars.omp_base: 127.0.0.1 on gza, the tailnet FQDN elsewhere)
#    plus open_port 8000/8080/8100. open_port is needed because omp fetches
#    deliberately bypass proxy env vars for loopback targets, so the direct
#    path must be granted. network.block=true is NOT usable: it denies
#    loopback too, open_port or not (probed: network_blocked). The local
#    wrapper runs `nono run`, not wrap: domain filtering is a proxy feature,
#    the proxy lives in run's supervisor, and wrap without a parent silently
#    enforces no allow-list at all (proven: a wrap-launched local-omp
#    fetched the open internet 2026-11-12; docs/cli/features/execution-modes
#    lists "no network proxy" as a direct-mode limit). Supervised mode also
#    keeps the herdr foreground-process name unsuitable for omp -- wanted:
#    herdr must not claim local-omp sessions.
# 9. local-omp state is invisible to the daily sandbox: omp.json DENIES
#    $HOME/.omp/profiles (deny outranks the ~/.omp allow), while the
#    generated local-omp.json drops that line to keep its own state. With
#    OMP_PROFILE=local (wrapper) sessions, logs, and the mnemopi store all
#    live under it, so sensitive facts cannot resurface in a networked
#    session's memory. The daily profile's deny must never block its own
#    workdir: nothing is ever worked on under ~/.omp/profiles.

set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "dev-agents is macOS-only; skipping."
  exit 0
fi

root="$(cd "$(dirname "$0")/.." && pwd)"
profile_src="$root/nono/omp.json"
wrapper_src="$root/nono/omp-wrapper.sh"
agents_md_src="$root/nono/AGENTS-sandbox.md"
local_wrapper_src="$root/nono/local-omp-wrapper.sh"
agents_local_src="$root/nono/AGENTS-sandbox-local.md"

profile_dst=/usr/local/etc/nono/omp.json
local_profile_dst=/usr/local/etc/nono/local-omp.json
wrapper_dst=/usr/local/bin/omp
local_wrapper_dst=/usr/local/bin/local-omp
raw_dst=/usr/local/bin/omp-unsandboxed

# The omp named profile local-omp runs in: its whole state tree, invisible
# to the daily sandbox by the deny of #9.
local_state="$HOME/.omp/profiles/local"

# Pinned like nwa's ompPkg (a versioned release binary with a checksum, not a
# brew formula: the wrapper must point at a stable path brew never touches).
omp_version="18.18.6"
omp_sha256="ed2e63eb43888eb76cb1409b245b1db4557c94dfad52dc545c9aaca01ebce82d"  # omp-darwin-arm64

fail() { echo "dev-agents check: $*" >&2; exit 1; }

# The model host from vars.omp_base (127.0.0.1 on gza, the tailnet FQDN
# elsewhere) -- the same source models.yml.tera renders, so the network
# allow-list tracks the catalog by construction.
omp_base() {
  local base
  base="$(mise vars | awk '$1 == "omp_base" { print $2 }')"
  [ -n "$base" ] || fail "vars.omp_base not set (base mise.toml)"
  printf '%s' "$base"
}

# local-omp.json, generated whole from omp.json -- the deliberate diffs only
# (invariants 8 and 9): the name, the state-tree deny carve-out, and the
# network allow-list. A repo copy would drift.
gen_local_profile() {
  jq --arg base "$(omp_base)" '
    .meta.name = "local-omp"
    | .meta.description = "omp offline: model host only, state isolated from the daily sandbox"
    | .filesystem.deny -= ["$HOME/.omp/profiles"]
    | .network = { "allow_domain": [$base], "open_port": [8000, 8080, 8100] }
  ' "$profile_src"
}

##### check -- the invariants, machine-checked ################################

check() {
  # strict (standalone `check`): installed differing from repo is a failure.
  # lenient (pre-install): staleness is what the install below cures --
  # refusing there is a deadlock no re-run can fix.
  local strict="${1:-strict}"
  # Inside a sandbox, /usr/local/etc/nono is invisible by design, and an
  # unreadable install would masquerade as "not installed yet" below. Refuse
  # rather than certify what cannot be seen (NONO_CAP_FILE is set by nono).
  # No escape hatch to name: a sandboxed child stays sandboxed (nested
  # sandbox_init EPERMs), and 'omp-unsandboxed -- <cmd>' is not an exec --
  # '--' starts omp message text. The caller hands the command to a plain terminal.
  [ -z "${NONO_CAP_FILE:-}" ] || fail "running inside a nono sandbox; the check must run unsandboxed -- run 'mise run dev-agents check' from a normal terminal"
  command -v nono >/dev/null || fail "nono not installed (Brewfile entry; run the bootstrap or brew install nono)"
  command -v jq >/dev/null || fail "jq not installed"

  nono profile validate "$profile_src" >/dev/null || fail "profile does not validate"

  # R2: exactly the three herdr control vars denied.
  local vars
  vars=$(jq -r '.environment.deny_vars | sort | join(",")' "$profile_src")
  [ "$vars" = "HERDR_CLIENT_SOCKET_PATH,HERDR_ENV,HERDR_SOCKET_PATH" ] \
    || fail "environment.deny_vars is '$vars', want the three herdr control vars"

  # R1: the herdr socket dir is denied, and the engine says a socket under it
  # is denied (the runtime EPERM proof lives in the header).
  jq -e '.filesystem.deny | index("$HOME/.config/herdr")' "$profile_src" >/dev/null \
    || fail "profile does not deny \$HOME/.config/herdr"
  # No `| head -1`: head exits early, nono SIGPIPEs writing the rest,
  # pipefail yields 141, and set -e kills the run before it prints anything.
  local why
  why=$(nono why --profile "$profile_src" --unix-socket "$HOME/.config/herdr/sessions/check/herdr.sock" 2>&1 || true)
  case "$why" in DENIED*) ;; *) fail "nono why: herdr socket not denied (${why:-no output})" ;; esac

  # R7: personal documents are unreachable by default-deny alone (no deny
  # line; a deny would outrank the workdir grant -- header). $root is the
  # neutral workdir: workdir readwrite would otherwise open any queried
  # path under it, so a repo moved under Documents fails here, correctly.
  local docs_why
  docs_why=$(nono why --profile "$profile_src" --workdir "$root" --path "$HOME/Documents" 2>&1 || true)
  case "$docs_why" in DENIED*) ;; *) fail "nono why: \$HOME/Documents not denied (${docs_why:-no output})" ;; esac

  # R8 + R9: local-omp's profile is generated, never a repo file (#8).
  local gen
  gen="$(mktemp)"
  gen_local_profile > "$gen" || fail "cannot generate local-omp profile"
  nono profile validate "$gen" >/dev/null || fail "generated local-omp profile does not validate"

  # R8: the model host answers, the remote world does not.
  local net_why remote_why
  net_why=$(nono why --profile "$gen" --host "$(omp_base)" --port 8100 2>&1 || true)
  case "$net_why" in ALLOWED*) ;; *) fail "local-omp: model host not reachable (${net_why:-no output})" ;; esac
  remote_why=$(nono why --profile "$gen" --host api.openai.com 2>&1 || true)
  case "$remote_why" in DENIED*) ;; *) fail "local-omp: remote network not denied (${remote_why:-no output})" ;; esac

  # R8 backstop: generation must not relax default-deny on documents.
  local local_docs_why
  local_docs_why=$(nono why --profile "$gen" --workdir "$root" --path "$HOME/Documents" 2>&1 || true)
  case "$local_docs_why" in DENIED*) ;; *) fail "local-omp: \$HOME/Documents not denied (${local_docs_why:-no output})" ;; esac

  # R9: the daily sandbox is blind to local state; local reads its own.
  local state_path="$local_state/agent/memories/mnemopi/mnemopi.db"
  local daily_state_why local_state_why
  daily_state_why=$(nono why --profile "$profile_src" --workdir "$root" --path "$state_path" 2>&1 || true)
  case "$daily_state_why" in DENIED*) ;; *) fail "daily omp can read local state (${daily_state_why:-no output})" ;; esac
  local_state_why=$(nono why --profile "$gen" --workdir "$root" --path "$state_path" 2>&1 || true)
  case "$local_state_why" in ALLOWED*) ;; *) fail "local-omp cannot read its own state (${local_state_why:-no output})" ;; esac

  # R6 as the engine sees it, not only as this file's text: the static scan
  # below reads the profile's own lists, while extends/groups can grant more
  # -- so the private key gets the same runtime re-assertion as the socket
  # and the documents.
  local key_why
  key_why=$(nono why --profile "$profile_src" --path "$HOME/.ssh/id_ed25519" 2>&1 || true)
  case "$key_why" in DENIED*) ;; *) fail "nono why: \$HOME/.ssh/id_ed25519 not denied (${key_why:-no output})" ;; esac

  # R4 + R3 + R2-keep: wrapper pins the profile by path, wraps (not runs),
  # exports HERDR_AGENT, and references nothing under \$HOME for the sandbox
  # authority itself.
  grep -q -- "--profile $profile_dst" "$wrapper_src" \
    || fail "wrapper does not pass --profile $profile_dst (a full path)"
  grep -q "nono wrap " "$wrapper_src" || fail "wrapper does not use 'nono wrap'"
  grep -q "export HERDR_AGENT=omp" "$wrapper_src" || fail "wrapper does not export HERDR_AGENT"
  grep -q "export BUN_INSTALL_CACHE_DIR=" "$wrapper_src" \
    || fail "wrapper does not redirect the Bun install cache (~/.bun is denied; the memory embedder dies)"

  # The same requirements on the local wrapper (#8/#9's entry point) --
  # except supervised mode is mandatory there: wrap hosts no proxy, so the
  # allow-list would be inert (its own comment carries the story).
  grep -q -- "--profile $local_profile_dst" "$local_wrapper_src" \
    || fail "local wrapper does not pass --profile $local_profile_dst (a full path)"
  grep -q "nono run " "$local_wrapper_src" \
    || fail "local wrapper does not use 'nono run' (domain filtering needs the supervised proxy)"
  grep -q "export HERDR_AGENT=local-omp" "$local_wrapper_src" \
    || fail "local wrapper does not export HERDR_AGENT=local-omp"
  grep -q "export OMP_PROFILE=local" "$local_wrapper_src" \
    || fail "local wrapper does not export OMP_PROFILE=local (state isolation, #9)"

  # R9 as text, before the engine sees it: daily denies the state tree,
  # and the generated profile must carry the carve-out.
  jq -e '.filesystem.deny | index("$HOME/.omp/profiles")' "$profile_src" >/dev/null \
    || fail "daily profile does not deny \$HOME/.omp/profiles"
  jq -e '.filesystem.deny | index("$HOME/.omp/profiles") | not' "$gen" >/dev/null \
    || fail "local-omp profile still denies its own state tree"

  # R6: no grants of $HOME itself, ~/.ssh, or secret-manager key paths --
  # both profiles, the generated one included.
  local pf grants
  for pf in "$profile_src" "$gen"; do
    grants=$(jq -r '[.filesystem | (.allow // [])[], (.allow_file // [])[], (.read // [])[], (.read_file // [])[]] | join(" ")' "$pf")
    # the patterns are literals on purpose: they match $HOME text inside the
    # profile JSON, never an expanded path
    # shellcheck disable=SC2016
    for bad in '"$HOME"' '$HOME/.ssh' sops age/ '$HOME/.gnupg' '$HOME/.aws'; do
      case " $grants " in *" $bad "*) fail "$pf grants a protected path: $bad" ;; esac
    done
  done

  # R5 on the installed copies: present, current, root:wheel.
  local p
  for f in "$profile_dst" "$local_profile_dst" "$wrapper_dst" "$local_wrapper_dst" "$raw_dst"; do
    [ -e "$f" ] || { echo "  (not installed yet: $f)"; continue; }
    p=$(stat -f '%Su:%Sg' "$f")
    [ "$p" = "root:wheel" ] || fail "$f is owned by $p, want root:wheel (the agent could edit its own sandbox)"
  done

  # Staleness of every installed piece. The wrapper is installed with the
  # brew prefix substituted, so it compares through the same substitution;
  # the raw binary carries its pin in --version, not a byte copy.
  local stale="" brew_prefix
  brew_prefix="$(brew --prefix 2>/dev/null || true)"
  if [ -e "$profile_dst" ] && ! cmp -s "$profile_src" "$profile_dst"; then
    stale="$profile_dst"
  fi
  if [ -e "$local_profile_dst" ] && ! cmp -s "$gen" "$local_profile_dst"; then
    stale="${stale:+$stale, }$local_profile_dst"
  fi
  if [ -n "$brew_prefix" ] && [ -e "$wrapper_dst" ] \
     && ! cmp -s <(sed "s|__BREW_PREFIX__|$brew_prefix|g" "$wrapper_src") "$wrapper_dst"; then
    stale="${stale:+$stale, }$wrapper_dst"
  fi
  if [ -n "$brew_prefix" ] && [ -e "$local_wrapper_dst" ] \
     && ! cmp -s <(sed "s|__BREW_PREFIX__|$brew_prefix|g" "$local_wrapper_src") "$local_wrapper_dst"; then
    stale="${stale:+$stale, }$local_wrapper_dst"
  fi
  if [ -e "$raw_dst" ] && ! "$raw_dst" --version 2>/dev/null | grep "$omp_version" >/dev/null; then
    stale="${stale:+$stale, }$raw_dst"
  fi
  if [ -n "$stale" ]; then
    if [ "$strict" = strict ]; then
      fail "$stale is stale; re-run mise run dev-agents"
    fi
    echo "  (stale: $stale -- the install below refreshes)"
  fi

  # PATH: the wrapper must win; a brew omp would shadow it (/opt/homebrew/bin
  # sorts first) -- install removes the formula. grep reads to EOF, never -q:
  # an early-exit reader SIGPIPEs brew, and pipefail turns a found omp into a
  # false condition.
  if [ -x /opt/homebrew/bin/omp ] || [ -x "$(brew --prefix 2>/dev/null)/bin/omp" ]; then
    echo "  warning: a brew-managed omp still shadows the wrapper on PATH"
  fi

  echo "dev-agents check: OK"
}

##### install -- root-owned files, sudo, TTY-gated like system-check ##########

# NOT named `install`: bash resolves functions before binaries, so the seed
# lines below would call the function itself and recurse. They additionally
# say `command install` so no future rename can re-arm it.
install_stack() {
  # TTY gate: an unattended bootstrap (ssh, no prompt possible) skips the
  # sudo part instead of hanging.
  if ! sudo -n true 2>/dev/null && [ ! -t 0 ]; then
    echo "==> dev-agents: the /usr/local install needs sudo and no TTY is attached; run 'mise run dev-agents' from a terminal."
    return 0
  fi

  brew_prefix="$(brew --prefix)"
  [ -x "$brew_prefix/bin/nono" ] || fail "nono missing at $brew_prefix/bin/nono (brew bundle first)"

  echo "==> Installing the sandbox (root:wheel, outside \$HOME, never symlinked)"
  # /usr/local/bin may not exist at all on a fresh Apple Silicon Mac; install
  # stages its INS@tmp file inside the target dir, so mkdir first.
  sudo mkdir -p /usr/local/etc/nono /usr/local/bin
  sudo install -o root -g wheel -m 644 "$profile_src" "$profile_dst"

  # local-omp.json is generated here, not stored in the repo (#8).
  local_profile="$(mktemp)"
  gen_local_profile > "$local_profile"
  sudo install -o root -g wheel -m 644 "$local_profile" "$local_profile_dst"
  rm -f "$local_profile"

  tmp_wrapper="$(mktemp)"
  sed "s|__BREW_PREFIX__|$brew_prefix|g" "$wrapper_src" > "$tmp_wrapper"
  sudo install -o root -g wheel -m 755 "$tmp_wrapper" "$wrapper_dst"
  rm -f "$tmp_wrapper"

  tmp_wrapper="$(mktemp)"
  sed "s|__BREW_PREFIX__|$brew_prefix|g" "$local_wrapper_src" > "$tmp_wrapper"
  sudo install -o root -g wheel -m 755 "$tmp_wrapper" "$local_wrapper_dst"
  rm -f "$tmp_wrapper"

  # The pinned raw binary, mirroring nwa's ompPkg.
  if ! "$raw_dst" --version 2>/dev/null | grep "$omp_version" >/dev/null; then
    echo "==> Fetching omp $omp_version (pinned, checksum-verified)"
    tmp_bin="$(mktemp)"
    curl -fL --retry 3 -o "$tmp_bin" \
      "https://github.com/can1357/oh-my-pi/releases/download/v$omp_version/omp-darwin-arm64"
    echo "$omp_sha256  $tmp_bin" | shasum -a 256 -c - \
      || fail "omp binary checksum mismatch -- refusing to install"
    sudo install -o root -g wheel -m 755 "$tmp_bin" "$raw_dst"
    rm -f "$tmp_bin"
  fi

  # The brew formula would shadow the wrapper on PATH: clean cutover, the
  # pinned release is the raw binary now.
  if brew list --formula 2>/dev/null | grep -x omp >/dev/null; then
    echo "==> Removing brew omp (superseded by $raw_dst)"
    brew uninstall omp
  fi

  # The dirs the profile grants. Creating them first mirrors nwa's tmpfiles
  # rules (Landlock needed the path to exist; Seatbelt does not care, but one
  # shape on both hosts is easier to reason about).
  mkdir -p "$HOME/.config/herdr" "$HOME/.omp/agent" "$HOME/.cache/nono-tmp/omp" \
           "$HOME/.local/share/uv" "$HOME/.local/bin" "$HOME/.config/git"

  # The agent's git pieces with ~/.ssh denied: the PUBLIC signing key and the
  # known hosts copy the wrapper points git at.
  if [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
    cmp -s "$HOME/.ssh/id_ed25519.pub" "$HOME/.config/git/sign.pub" \
      || command install -m 644 "$HOME/.ssh/id_ed25519.pub" "$HOME/.config/git/sign.pub"
  fi
  if [ -f "$HOME/.ssh/known_hosts" ]; then
    cmp -s "$HOME/.ssh/known_hosts" "$HOME/.config/git/known_hosts" \
      || command install -m 644 "$HOME/.ssh/known_hosts" "$HOME/.config/git/known_hosts"
  fi

  # The sandbox note omp loads into every session, so denials cost one line
  # instead of a token-spending investigation.
  cmp -s "$agents_md_src" "$HOME/.omp/agent/AGENTS.md" \
    || command install -m 644 "$agents_md_src" "$HOME/.omp/agent/AGENTS.md"

  # Seed the omp named profile local-omp runs in (#9). A named profile sees
  # only its own config, so point it at the same rendered files: config.yml
  # resolves into the repo (already granted via allow_file in both profiles),
  # models.yml under the granted ~/.omp. The cache symlinks share runtime
  # material and model weights -- static, no doc content, and un-downloadable
  # offline by design. The offline note teaches local-omp its rules.
  mkdir -p "$local_state/tmp" "$local_state/agent"
  ln -sfn "$HOME/.omp/agent/models.yml" "$local_state/agent/models.yml"
  ln -sfn "$HOME/.omp/agent/config.yml" "$local_state/agent/config.yml"
  ln -sfn "$HOME/.omp/agent/cache" "$local_state/agent/cache"
  ln -sfn "$HOME/.omp/cache" "$local_state/cache"
  cmp -s "$agents_local_src" "$local_state/agent/AGENTS.md" \
    || command install -m 644 "$agents_local_src" "$local_state/agent/AGENTS.md"

  echo "==> Installed: $(/usr/local/bin/omp-unsandboxed --version), wrapped by $wrapper_dst and $local_wrapper_dst"
}

case "${1:-all}" in
  check) check strict ;;
  all)   check lenient; install_stack ;;
  *)     echo "usage: mise run dev-agents [check|all]"; exit 2 ;;
esac

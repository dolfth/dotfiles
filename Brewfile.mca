# mca: the laptop -- the GUI software. The desktop runs headless, so these
# are laptop only. The shared entries live in Brewfile (see it for the how
# and the why).

# trusted: true -- per-machine tap trust for Homebrew 6+ (why: Brewfile.gza).
tap "chamburr/tap", trusted: true
tap "nikitabobko/tap", trusted: true
# Window borders for aerospace (its config is not in this repo).
tap "FelixKratz/formulae", trusted: true

cask "balenaetcher"
cask "brave-browser"
cask "chamburr/tap/glance"
cask "citrix-workspace"
cask "grandperspective"
cask "nikitabobko/tap/aerospace"
brew "FelixKratz/formulae/borders"
cask "iina"
cask "imageoptim"
cask "lulu"
cask "monitorcontrol"
cask "notunes"
cask "obsidian"
cask "soulseek"
cask "the-unarchiver"
cask "utm"
cask "vscodium"
cask "whatcable"
# Background sync, laptop only (the launchd agent for it stays in
# mise.mca.toml, so it runs under mise, not `brew services`).
brew "syncthing"

# App Store -- mas installs by ID; the name is only a label. The explicit
# `id:` form is required by current homebrew-bundle: a positional-ID line
# ("mas 1435127111") aborts the whole bundle with "options[:id] should be
# an Integer". The app must already be in your purchase history.
mas "KeePassium", id: 1435127111
mas "Keynote", id: 361285480
mas "Numbers", id: 361304891
mas "Obsidian Web Clipper", id: 6720708363
mas "Pages", id: 361309726
mas "Pixelmator Pro", id: 1289583905
mas "uBlock Origin Lite", id: 6745342698

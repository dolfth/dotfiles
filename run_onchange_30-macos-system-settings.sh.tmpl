{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
#
# Sudo-requiring system settings, deliberately split from
# run_after_20-macos-defaults.sh: this one prompts for a password, which would
# hang an unattended `chezmoi apply` (editor, cron, ...). The TTY check below
# skips it instead of hanging.
#
# `run_onchange_` with no `run_after_`: fires only on first apply and when
# this file's rendered text changes, so the sudo prompt stays rare. Deleting a
# line stops setting that thing; it does NOT restore the previous value.
#
# To make it never run automatically, rename it without the run_ prefix
# (macos-system-settings.sh.tmpl) and run it by hand on new machines.

set -uo pipefail   # no -e: one failing sudo command shouldn't abort the rest

# Skip silently in non-interactive contexts rather than hanging on a prompt.
if [ ! -t 0 ]; then
  echo "==> Skipping system settings (no TTY; run 'chezmoi apply' in a terminal)"
  exit 0
fi

echo "==> System settings (sudo required)"
sudo -v || { echo "No sudo; skipping."; exit 0; }

##### Touch ID for sudo ######################################################
#
# Unlock sudo with Touch ID. Prefers the template file when macOS ships one.

if [ ! -f /etc/pam.d/sudo_local ]; then
  if [ -f /etc/pam.d/sudo_local.template ]; then
    sudo sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  else
    printf 'auth       sufficient     pam_tid.so\n' \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  fi
  echo "  Touch ID for sudo enabled"
fi

##### Firewall ###############################################################
#
# Block unsolicited inbound connections; stealth mode hides the machine from
# port scans.

sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on >/dev/null
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on >/dev/null

# Optional: block ALL incoming connections (breaks file sharing, AirDrop, SSH).
# sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setblockall on >/dev/null

##### Guest account ##########################################################
#
# Disable and remove the Guest account.

sudo defaults write /Library/Preferences/com.apple.loginwindow GuestEnabled -bool false
sudo dscl . -delete /Users/Guest 2>/dev/null || true

##### Login window #############################################################
#
# Show the username field instead of the account picker at the login screen.
sudo defaults write /Library/Preferences/com.apple.loginwindow SHOWFULLNAME -bool true

##### Power management #######################################################
#
# Profile comes from `kind` for this host in .chezmoidata.yaml; unknown hosts
# get the laptop profile, which is harmless on a desktop (it just sleeps).
{{- $host := trimSuffix ".local" .chezmoi.hostname -}}
{{- if hasKey . "computerName" -}}{{ $host = .computerName }}{{ end -}}
{{- $kind := dig $host "kind" "laptop" .hosts }}
{{ if eq $kind "desktop" }}
# Desktop (omlx server): nothing ever sleeps except the display, which does
# not affect running processes. No deep standby/hibernation, no Power Nap
# (it only matters for a sleeping Mac), no Low Power Mode throttling. Restart
# by itself after a power cut; wake on LAN and keep TCP alive as backups.
sudo pmset -a sleep 0 disksleep 0 standby 0 autopoweroff 0 hibernatemode 0 \
  powernap 0 lowpowermode 0 displaysleep 15 autorestart 1 womp 1 tcpkeepalive 1
{{- else }}
# Laptop: sleep the whole machine when idle (not just the display), drop to
# deep standby, and conserve battery. Split by power source so the laptop
# sleeps promptly on battery but is a little more patient on AC.
#
# On battery -- prompt sleep to preserve charge:
sudo pmset -b sleep 5 displaysleep 5 disksleep 10 standby 1 autopoweroff 1 powernap 0
#
# On AC -- more patient, but it still sleeps:
sudo pmset -c sleep 10 displaysleep 10 disksleep 10 powernap 0
{{- end }}
#
# Keep the screen lock on wake -- the machine should not wake to an open GUI:
sudo pmset -a disablescreenlock 0

##### Hostname ################################################################
# Display name, official hostname and Bonjour name, all from the machine's own
# hostname (e.g. `somehost.local` -> `somehost`) so each machine manages
# itself. Override with computerName = "..." under [data] in
# ~/.config/chezmoi/chezmoi.toml (`chezmoi init` asks for it on macOS).
sudo scutil --set ComputerName {{ $host | quote }}
sudo scutil --set HostName {{ $host | quote }}
sudo scutil --set LocalHostName {{ $host | quote }}
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server \
  NetBIOSName -string {{ $host | quote }}

##### Software Update #########################################################
#
# Never install macOS updates by themselves (that is how Tahoe arrived), and
# don't pre-download them either. Still check, so System Settings shows what
# is available; install by hand with `softwareupdate -l` / `-i <label>`.
#
# Security is split out:
#   - ConfigDataInstall: XProtect, Gatekeeper and malware-removal data. Pure
#     data files, never restart -- on everywhere.
#   - CriticalUpdateInstall: "Security Responses and system files" (Rapid
#     Security Responses / Background Security Improvements). Small patches
#     to the current version, but they can need a restart -- on for the
#     laptop, off for the desktop so omlx is never taken down unasked.
# Point releases (26.x.y) are full macOS updates, even when they are "only"
# security fixes, and fall under AutomaticallyInstallMacOSUpdates.
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool {{ if eq $kind "desktop" }}false{{ else }}true{{ end }}

{{ if eq $kind "desktop" -}}
##### Screen Sharing ##########################################################
#
# VNC-based Screen Sharing (vnc://gza.local, or the tailnet name) for the
# occasional GUI visit. Access follows System Settings > General > Sharing >
# Screen Sharing (default: administrators). If it does not show as on there,
# toggle it once by hand -- newer macOS versions sometimes insist.
sudo launchctl enable system/com.apple.screensharing
sudo launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.screensharing.plist 2>/dev/null || true

{{ end -}}
##### FileVault ################################################################
#
# Not automatable: `fdesetup enable` needs interactive handling of the
# recovery key, and you should not write that key to a script's stdout.

if ! fdesetup status | grep -q "FileVault is On"; then
  echo "  FileVault is OFF. Enable it: System Settings > Privacy & Security"
fi

##### Manual checklist ########################################################
#
# Things no script can set, because the TCC database is SIP-protected:
#   - Full Disk Access for your terminal (needed for anything touching
#     ~/Library/Mail or /dev)
#   - Accessibility permissions for window managers, hotkey tools, etc.
#   - Screen Recording for capture tools
#   - iCloud sign-in and per-service toggles
#
# Keep this list here so it's version-controlled alongside everything else.

echo "==> System settings applied."
{{- end }}

# Which keys may log in: the login_keys var, the two Mac keys only. nwa
# is a leaf -- its key verifies commits (ssh_keys, allowed_signers) but
# never logs in on a Mac. mise owns the rendered file; a key added by
# hand is overwritten -- put it in the var.
{% for key in vars.login_keys | trim | split(pat="\n") %}{{ key }}
{% endfor %}

# omp's model catalog (the file omp reads for available providers/models).
# This is a whole file: the repo is the source of truth for the provider
# list.
#
# The one host-specific bit is baseUrl. The omlx and splash servers run on
# the desktop (gza), so:
#   - on gza they are local      -> 127.0.0.1
#   - on nwa (and any other box) -> the tailnet FQDN (MagicDNS does not
# resolve the bare hostname).
# vars.omp_base carries that: "127.0.0.1" in the gza module,
# "gza.foxhound-insen.ts.net" in the base mise.toml.
#
# If you add or change a model through an omp UI, that edit is a local
# change and the next `mise bootstrap` resets this file to the repo version
# -- edit this source instead.
---
providers:
  omlx:
    api: openai-completions
    apiKey: '1234'
    baseUrl: http://{{ vars.omp_base }}:8080/v1
    compat:
      maxTokensField: max_tokens
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      supportsDeveloperRole: false
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Qwen3.8-27B-oQ4e-mtp:thinking
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (thinking)
      reasoning: true
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Qwen3.8-27B-oQ4e-mtp:instruct
      input:
      - text
      - image
      maxTokens: 8192
      name: Qwen3.8 27B (instruct)
      reasoning: false
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Swift-Qwen3.8-27b-oQ4e-mtp
      input:
      - text
      - image
      maxTokens: 32768
      name: Swift Qwen3.8 27B
      reasoning: true
  splash:
    api: openai-completions
    apiKey: local
    baseUrl: http://{{ vars.omp_base }}:8000/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (Splash)
      reasoning: true
  splash-kat:
    api: openai-completions
    apiKey: local
    baseUrl: http://{{ vars.omp_base }}:8100/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 188409
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: bartowski/Kwaipilot_KAT-Coder-V2.5-Dev-GGUF:Q4_K_M
      input:
      - text
      maxTokens: 32768
      name: KAT-Coder 35B (Splash)
      reasoning: true

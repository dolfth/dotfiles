# omp's model catalog: the provider list, rendered whole on every bootstrap.
# The one host-specific bit is baseUrl: the servers run on gza, so
# vars.omp_base is "127.0.0.1" there (the gza module) and the gza tailnet
# FQDN elsewhere (the base -- MagicDNS resolves the FQDN, never the bare
# hostname).
#
# If you add or change a model through an omp UI, that edit is a local
# change and the next `mise bootstrap` resets this file -- edit this source
# instead.
#
# gza's GPU pool serves ONE provider at a time (flash-fn by default; `mise
# run gpupool 27|mlx` switches) -- the other providers' baseUrls refuse
# connections until their server owns the pool again.
---
providers:
  omlx:
    api: openai-completions
    apiKey: '1234'
    baseUrl: http://{{ vars.omp_base }}:8080/v1
    compat:
      maxTokensField: max_tokens
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      supportsDeveloperRole: false
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Qwen3.8-27B-oQ4e-mtp:thinking
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (thinking)
      reasoning: true
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Qwen3.8-27B-oQ4e-mtp:instruct
      input:
      - text
      - image
      maxTokens: 8192
      name: Qwen3.8 27B (instruct)
      reasoning: false
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: Swift-Qwen3.8-27b-oQ4e-mtp
      input:
      - text
      - image
      maxTokens: 32768
      name: Swift Qwen3.8 27B
      reasoning: true
  splash:
    api: openai-completions
    apiKey: local
    baseUrl: http://{{ vars.omp_base }}:8000/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (Splash)
      reasoning: true
  splash-fn:
    api: openai-completions
    apiKey: local
    baseUrl: http://{{ vars.omp_base }}:8100/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 262144
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 Flash-Next (Splash)
      reasoning: true

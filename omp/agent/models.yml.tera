# omp's model catalog: the provider list, rendered whole on every bootstrap.
# baseUrl renders from vars.omp_base, which the gza module sets to "127.0.0.1"
# -- the catalog is gza-only: omp lives there alone (the base keeps the gza
# tailnet FQDN for any host that later points at the pool).
#
# A model added or changed through an omp UI is a local change: the next
# `mise bootstrap` resets this file. Edit this source instead.
#
# One provider, one endpoint: llama-swap on gza:9292 fronts the GPU pool. The pool
# stays single-tenant -- a model pick that is not loaded stops the running engine
# and loads the picked one before the request answers, so a pick can pay the load
# once (Flash-Next is a 111 GB image); apiKey is the pool key, read from
# ~/.config/llama-swap/api_key by exec(). omlx is out of the pool: installed
# on gza, no provider here.
---
providers:
  splash:
    api: openai-completions
    apiKey: '{{ exec(command="cat $HOME/.config/llama-swap/api_key 2>/dev/null || true") }}'
    baseUrl: http://{{ vars.omp_base }}:9292/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (Splash)
      reasoning: true
    - contextWindow: 262144
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 Flash-Next (Splash)
      reasoning: true

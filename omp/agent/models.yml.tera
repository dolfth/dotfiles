# omp's model catalog, rendered whole on every bootstrap: a model added or
# changed through an omp UI is a local change, the next bootstrap resets it
# -- edit this source. The catalog is gza-only (omp lives there alone);
# baseUrl renders from vars.omp_base.
#
# One provider, one endpoint: llama-swap on gza:9292 fronts the GPU pool,
# single-tenant. A pick that is not loaded stops the running engine and
# loads the picked model before its request answers -- that pick pays the
# load once. apiKey is the pool key, read by exec(). omlx is out of the
# pool: installed, no provider here.
---
providers:
  splash:
    api: openai-completions
    apiKey: '{{ exec(command="cat $HOME/.config/llama-swap/api_key 2>/dev/null || true") }}'
    baseUrl: http://{{ vars.omp_base }}:9292/v1
    compat:
      streamFirstEventTimeoutMs: 0
      streamIdleTimeoutMs: 600000
      thinkingFormat: qwen-chat-template
    models:
    - contextWindow: 157696
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 27B (Splash)
      reasoning: true
    - contextWindow: 262144
      cost:
        cacheRead: 0
        cacheWrite: 0
        input: 0
        output: 0
      id: unsloth/Qwen3.8-Flash-Next-GGUF:UD-Q4_K_XL
      input:
      - text
      - image
      maxTokens: 32768
      name: Qwen3.8 Flash-Next (Splash)
      reasoning: true

{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# run_after_: runs on every apply, so settings flipped by hand get put back.
# Deleting a line stops setting it; it doesn't restore the old value.

# Sandboxed apps (Mail, TextEdit, Siri, Displays, Safari) keep their domain in
# a container only Full Disk Access can write, which SSH sessions lack. Reading
# the TCC database needs the same access, so it doubles as the check. Without
# it, those lines (under `if [ -n "$fda" ]`) wait for an apply that has it.
fda=1
if ! head -c1 "/Library/Application Support/com.apple.TCC/TCC.db" >/dev/null 2>&1; then
  fda=
  echo "==> No Full Disk Access (e.g. over SSH): skipping Mail, TextEdit, Siri and Displays defaults"
fi

# Killing Dock and WindowManager rebuilds Spaces and makes AeroSpace re-tile,
# so "Apply" restarts them only if a domain they read changed. Re-writing a
# value leaves the export unchanged. Add new such domains here.
snapshot() {
  for d in com.apple.dock com.apple.spaces com.apple.WindowManager \
           com.apple.finder com.apple.menuextra.clock NSGlobalDomain; do
    defaults export "$d" - 2>/dev/null || true
  done
  defaults -currentHost export com.apple.controlcenter - 2>/dev/null || true
  defaults -currentHost export NSGlobalDomain - 2>/dev/null || true
}
before=$(snapshot | shasum)

##### Dock & Mission Control ##################################################

# Hide the Dock
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock autohide-delay -float 0
defaults write com.apple.dock autohide-time-modifier -float 0.4

# Icon size
defaults write com.apple.dock tilesize -int 64

# Translucent icons for hidden apps
defaults write com.apple.dock showhidden -bool true

# Hover actions on non-folder Dock items
defaults write com.apple.dock enable-spring-load-actions-on-all-items -bool true

# No bounce on launch
defaults write com.apple.dock launchanim -bool false

# Minimise into the app's icon; effect: genie | scale | suck
defaults write com.apple.dock minimize-to-application -bool true
defaults write com.apple.dock mineffect -string "scale"
defaults write com.apple.dock expose-animation-duration -float 0.1

# Don't reorder Spaces; no recent apps in the Dock
defaults write com.apple.dock mru-spaces -bool false
defaults write com.apple.dock show-recents -bool false

# true = one Space spans all displays ("Displays have separate Spaces" off);
# works better with AeroSpace
defaults write com.apple.spaces spans-displays -bool true

# Group windows by app in Exposé
defaults write com.apple.dock expose-group-apps -bool true

# Click wallpaper to show Desktop: 0 = only in Stage Manager, 1 = always
defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -int 0

# No built-in tiling; AeroSpace manages windows.
defaults write com.apple.WindowManager EnableTilingByEdgeDrag -bool false
defaults write com.apple.WindowManager EnableTopTilingByEdgeDrag -bool false
defaults write com.apple.WindowManager EnableTilingOptionAccelerator -bool false
defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false

# Hot corners: bottom-left shows Desktop, bottom-right (Quick Note) off.
# Actions: 0 = none, 2 = Mission Control, 3 = Application Windows, 4 = Desktop,
#          5 = Start Screen Saver, 10 = Put Display to Sleep, 11 = Launchpad,
#          12 = Notification Centre, 13 = Lock Screen, 14 = Quick Note
# Modifiers: 0 = none, 131072 = Shift, 262144 = Ctrl, 524288 = Option,
#            1048576 = Cmd
defaults write com.apple.dock wvous-bl-corner -int 4
defaults write com.apple.dock wvous-br-corner -int 0

##### Finder ##################################################################

# Hide dotfiles (Cmd+Shift+. toggles)
defaults write com.apple.finder AppleShowAllFiles -bool false

# New window view: Nlsv = list, icnv = icon, clmv = column, Flwv = gallery
defaults write com.apple.finder FXPreferredViewStyle -string "clmv"

# Keep folder views; path bar, status bar, POSIX path in title; folders first
defaults write com.apple.finder FXItemTimeout -int 0
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true
defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
defaults write com.apple.finder _FXSortFoldersFirst -bool true
defaults write com.apple.finder _FXSortFoldersFirstOnDesktop -bool true

# Sort by name; no warning when changing an extension
defaults write com.apple.finder FXSortBy -string "name"
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

# Spring-loaded folders open instantly
defaults write NSGlobalDomain com.apple.springing.delay -float 0

# Search: SCcf = current folder, SCsp = previous, SCev = this Mac
defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

# New windows: PfHm = Home, PfDe = Desktop, PfDo = Documents
defaults write com.apple.finder NewWindowTarget -string "PfHm"
defaults write com.apple.finder NewWindowTargetPath -string "file://${HOME}/"

# Cmd+Q quits Finder; empty the trash after 30 days
defaults write com.apple.finder QuitMenuItem -bool true
defaults write com.apple.finder FXRemoveOldTrashItems -bool true

# Desktop: no internal drive, show servers; open a window for new removable
# disks
defaults write com.apple.finder ShowHardDrivesOnDesktop -bool false
defaults write com.apple.finder ShowMountedServersOnDesktop -bool true
defaults write com.apple.finder OpenWindowForNewRemovableDisk -bool true

# Expanded Get Info panes
defaults write com.apple.finder FXInfoPanesExpanded -dict \
  General -bool true \
  OpenWith -bool true \
  Privileges -bool true

# AirDrop over Ethernet and other non-WiFi interfaces
defaults write com.apple.NetworkBrowser BrowseAllInterfaces -bool true
# Reduce motion (also kills Finder window animations)
# defaults write com.apple.universalaccess reduceMotion -bool true

##### Global ##################################################################

# Auto light/dark mode. `defaults delete` exits 1 when the key is already gone,
# which set -e would abort on, so guard it.
defaults write NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically -bool true
if defaults read NSGlobalDomain AppleInterfaceStyle >/dev/null 2>&1; then
  defaults delete NSGlobalDomain AppleInterfaceStyle
fi

# Manual light or dark mode
# defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"

# Show all file extensions
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Faster key repeat and initial delay
defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain KeyRepeat -int 2

# No auto-capitalisation, autocorrect, spell-check underline, smart quotes or
# smart dashes
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
defaults write NSGlobalDomain NSContinuousSpellCheckingEnabled -bool false
defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false

# No wallpaper tinting, natural scrolling or App Nap
defaults write NSGlobalDomain AppleEnableWindowTinting -bool false
defaults write NSGlobalDomain com.apple.swipescrolldirection -bool false
defaults write NSGlobalDomain NSAppSleepDisabled -bool true

# Expanded print and save dialogs (apps read either key)
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

# Double-clicking a title bar: None | Minimize | Maximize | Fill
defaults write NSGlobalDomain AppleActionOnDoubleClick -string "Minimize"

# Always show scrollbars; ask to save on close, even with autosave
defaults write NSGlobalDomain AppleShowScrollBars -string "Always"
defaults write NSGlobalDomain NSCloseAlwaysConfirmsChanges -bool true

# Reopen an app's windows on relaunch
defaults write NSGlobalDomain NSQuitAlwaysKeepsWindows -bool true

# Save new documents locally, not to iCloud; full names over nicknames
defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
defaults write NSGlobalDomain NSPersonNameDefaultShouldPreferNicknamesPreference -bool false

# Detailed fast-user-switching menu
defaults write NSGlobalDomain userMenuExtraStyle -int 2

# Selection highlight colour (RGB, 0-1)
defaults write NSGlobalDomain AppleHighlightColor -string "0.764700 0.976500 0.568600"

# No focus-ring animation; near-instant resizes
defaults write NSGlobalDomain NSUseAnimatedFocusRing -bool false
defaults write NSGlobalDomain NSWindowResizeTime -float 0.001

# Control characters as ^C; don't auto-terminate idle apps
defaults write NSGlobalDomain NSTextShowsControlCharacters -bool true
defaults write NSGlobalDomain NSDisableAutomaticTermination -bool true

# Ctrl+Cmd+drag moves a window from anywhere
defaults write NSGlobalDomain NSWindowShouldDragOnGesture -bool true

# Menu bar item spacing (needs -currentHost)
defaults -currentHost write -globalDomain NSStatusItemSelectionPadding -int 4
defaults -currentHost write -globalDomain NSStatusItemSpacing -int 4

# No "downloaded from the internet" dialog; Gatekeeper still blocks unsigned
# apps
defaults write com.apple.LaunchServices LSQuarantine -bool false

# Quit the printer queue when jobs finish
defaults write com.apple.print.PrintingPrefs "Quit When Finished" -bool true

##### Accessibility / Zoom ####################################################

# Reduce transparency; always show title bar proxy icons (Sonoma+ hides them
# until hover)
defaults write com.apple.universalaccess reduceTransparency -bool true
defaults write com.apple.universalaccess showWindowTitlebarIcons -bool true

# Modifier+scroll zooms; the zoomed view follows keyboard focus.
defaults write com.apple.universalaccess closeViewScrollWheelToggle -bool true
# Modifier defaults to Ctrl; HIDScrollZoomModifierMask 131072 = Shift,
# 524288 = Option, 1048576 = Cmd
defaults write com.apple.universalaccess closeViewZoomFollowsFocus -bool true

##### Keyboard ################################################################

# Holding a key repeats it instead of showing the accent popover
# defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

# Tab reaches all controls. Sonoma+ uses 2; 3 is legacy.
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2

# Fn/Globe alone: 0 = nothing, 1 = input source, 2 = emoji, 3 = dictation
defaults write com.apple.HIToolbox AppleFnUsageType -int 2

##### Trackpad & Mouse ########################################################

# Tap to click: both device domains, plus -currentHost for the login window
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

# Corner secondary click (two-finger click is on by default); -currentHost
# mirrors it for the login window. Corner: 0 = off, 1 = bottom-left,
# 2 = bottom-right
defaults -currentHost write NSGlobalDomain com.apple.trackpad.trackpadCornerClickBehavior -int 1
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadCornerSecondaryClick -int 2

# Tracking speed, 0-3
defaults write NSGlobalDomain com.apple.trackpad.scaling -float 2.0
defaults write NSGlobalDomain com.apple.mouse.scaling -float 1.5

# No mouse acceleration
defaults write NSGlobalDomain com.apple.mouse.linear -bool true

##### .DS_Store hygiene #######################################################

# None on network shares or USB drives
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

##### Screenshots ############################################################

# Desktop, png (defaults); no window shadow, no timestamp in the name
defaults write com.apple.screencapture disable-shadow -bool true
defaults write com.apple.screencapture include-date -bool false

# No floating thumbnail, so the file is written at once
defaults write com.apple.screencapture show-thumbnail -bool false

##### Screen lock #############################################################

# Password immediately after screen saver or sleep. Deprecated since Ventura
# (System Settings > Lock Screen) but still works on Tahoe; verify there.
defaults write com.apple.screensaver askForPassword -int 1
defaults write com.apple.screensaver askForPasswordDelay -int 0

##### Menu bar & clock ########################################################

# Battery percentage has no defaults key; set it in System Settings.
# defaults -currentHost write
#   com.apple.controlcenter BatteryShowPercentage -bool true

# Items: 1 = menu bar, 2 = Control Centre, 3 = both, 8 = hidden. Key names
# contain spaces.
defaults -currentHost write com.apple.controlcenter "NSStatusItem Visible UserSwitcher" -int 1
# 6 = round picture, 10 = full name
defaults -currentHost write com.apple.controlcenter UserSwitcher -int 6

# Clock
defaults write com.apple.menuextra.clock Show24Hour -bool true
defaults write com.apple.menuextra.clock ShowAMPM -bool false
defaults write com.apple.menuextra.clock ShowDate -int 1
# 24-hour time everywhere
defaults write NSGlobalDomain AppleICUForce24HourTime -bool true

##### Safari ##################################################################

# Safari's domain is sandboxed and needs Full Disk Access. To use a line,
# uncomment it inside an `if [ -n "$fda" ]` block like Mail's.

# defaults write com.apple.Safari IncludeDevelopMenu -bool true
# defaults write com.apple.Safari IncludeInternalDebugMenu -bool true
# defaults write com.apple.Safari ShowFullURLInSmartSearchField -bool true
# defaults write com.apple.Safari AutoOpenSafeDownloads -bool false
# defaults write com.apple.Safari ShowFavoritesBar -bool false
# defaults write com.apple.Safari SendDoNotTrackHTTPHeader -bool true
# defaults write com.apple.Safari UniversalSearchEnabled -bool false
# defaults write com.apple.Safari SuppressSearchSuggestions -bool true
# defaults write com.apple.Safari WarnAboutFraudulentWebsites -bool true
# defaults write com.apple.Safari AutoFillFromAddressBook -bool false
# defaults write com.apple.Safari AutoFillPasswords -bool false
# defaults write com.apple.Safari AutoFillCreditCardData -bool false
# defaults write com.apple.Safari AutoFillMiscellaneousForms -bool false
# defaults write com.apple.Safari HomePage -string "about:blank"

# Web inspector in all WebKit views, not just Safari
defaults write NSGlobalDomain WebKitDeveloperExtras -bool true

##### Mail ####################################################################

if [ -n "$fda" ]; then
  # Attachments as icons; no reply/send animations
  defaults write com.apple.mail DisableInlineAttachmentViewing -bool true
  defaults write com.apple.mail DisableReplyAnimations -bool true
  defaults write com.apple.mail DisableSendAnimations -bool true

  # Copy just the address, not "Name <addr>"
  defaults write com.apple.mail AddressesIncludeNameOnPasteboard -bool false

  # Cmd+Enter sends (@ = Cmd, \U21a9 = return)
  defaults write com.apple.mail NSUserKeyEquivalents -dict-add "Send" "@\U21a9"

  # Drafts threaded, newest first
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "DisplayInThreadedMode" -string "yes"
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortedDescending" -string "yes"
  defaults write com.apple.mail DraftsViewerAttributes -dict-add "SortOrder" -string "received-date"
fi

##### TextEdit ################################################################

if [ -n "$fda" ]; then
  # Plain text, UTF-8 (4) in and out
  defaults write com.apple.TextEdit RichText -int 0
  defaults write com.apple.TextEdit PlainTextEncoding -int 4
  defaults write com.apple.TextEdit PlainTextEncodingForWrite -int 4
fi

##### Activity Monitor ########################################################

# Show: 100 = all, 101 = hierarchical, 102 = mine, 103 = system,
# 104 = other users, 105 = active, 106 = inactive, 107 = windowed
defaults write com.apple.ActivityMonitor ShowCategory -int 100
# Sort by CPU
defaults write com.apple.ActivityMonitor SortColumn -string "CPUUsage"
defaults write com.apple.ActivityMonitor SortDirection -int 0

# Dock icon: 0 = app icon, 2 = network, 3 = disk, 5 = CPU, 6 = CPU history
defaults write com.apple.ActivityMonitor IconType -int 5

##### Photos #################################################

# Don't open Photos when a camera or phone is connected
defaults write com.apple.ImageCapture disableHotPlug -bool true

##### Time Machine ############################################################

# Don't offer new disks for backup
defaults write com.apple.TimeMachine DoNotOfferNewDisksForBackup -bool true

##### Displays ################################################################

# Show the display list in Displays settings
if [ -n "$fda" ]; then
  defaults write com.apple.Displays-Settings.extension showListByDefault -int 2
fi

##### App Store ###############################################################

# No automatic app updates
defaults write com.apple.commerce AutoUpdate -bool false

##### Apple Intelligence #######################################################

# Undocumented opt-out; the ID changes between releases. Verify with
# `defaults read com.apple.CloudSubscriptionFeatures.optIn`. The supported
# route is System Settings > Apple Intelligence.
defaults write com.apple.CloudSubscriptionFeatures.optIn "545129924" -bool false

##### Siri & ads ##############################################################

# Siri off and out of the menu bar; no personalised ads. macOS 27 folds Siri
# into Spotlight, so check System Settings > Siri.
defaults write com.apple.assistant.support "Assistant Enabled" -bool false
if [ -n "$fda" ]; then
  defaults write com.apple.Siri StatusMenuVisible -bool false
fi
defaults write com.apple.AdLib allowApplePersonalizedAdvertising -bool false

##### Show ~/Library ##########################################################

chflags nohidden "${HOME}/Library" 2>/dev/null || true

##### Apply ###################################################################

if [ "$(snapshot | shasum)" != "$before" ]; then
  # Flush cfprefsd and reload settings, so most apply without a logout.
  killall cfprefsd 2>/dev/null || true
  /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u 2>/dev/null || true
  # Most settings are read only at launch.
  for app in Dock Finder SystemUIServer ControlCenter WindowManager; do
    killall "$app" >/dev/null 2>&1 || true
  done
fi
{{- end -}}

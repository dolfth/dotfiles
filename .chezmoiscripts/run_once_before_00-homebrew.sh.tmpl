{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Installs Homebrew before brew bundle (10) needs it. The README bootstrap
# already installed the Command Line Tools, so the installer skips them.
# run_once_: on a Mac with Homebrew it just records itself as done.

if command -v brew >/dev/null 2>&1 || [ -x /opt/homebrew/bin/brew ]; then
  exit 0
fi

# The installer needs sudo and a keypress.
if [ ! -t 0 ]; then
  echo "Homebrew is not installed and there is no terminal to install it." >&2
  echo "Run 'chezmoi apply' in a terminal." >&2
  exit 1
fi

echo "==> Installing Homebrew"
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
{{- end -}}

{{- if eq .chezmoi.os "darwin" -}}
{{- $host := includeTemplate "host" . -}}
{{- $kind := includeTemplate "kind" . -}}
#!/bin/bash
#
# Settings that need sudo, split from the defaults script (20) so an
# unattended apply skips them instead of hanging on a password prompt.
#
# run_onchange_: runs on first apply and when the rendered text changes, so
# the prompt stays rare. Deleting a line stops setting it; it doesn't restore
# the old value. To run it only by hand, drop the run_ prefix.

set -uo pipefail   # no -e: one failure shouldn't abort the rest

if [ ! -t 0 ]; then
  echo "==> Skipping system settings (no TTY; run 'chezmoi apply' in a terminal)"
  exit 0
fi

echo "==> System settings (sudo required)"
sudo -v || { echo "No sudo; skipping."; exit 0; }

##### Touch ID for sudo ######################################################
#
# From Apple's template when macOS ships one.

if [ ! -f /etc/pam.d/sudo_local ]; then
  if [ -f /etc/pam.d/sudo_local.template ]; then
    sudo sed 's/^#auth/auth/' /etc/pam.d/sudo_local.template \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  else
    printf 'auth       sufficient     pam_tid.so\n' \
      | sudo tee /etc/pam.d/sudo_local >/dev/null
  fi
  echo "  Touch ID for sudo enabled"
fi

##### Firewall ###############################################################
#
# Block unsolicited inbound connections; stealth mode ignores probes.

sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on >/dev/null
sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on >/dev/null

# Block ALL inbound (breaks file sharing, AirDrop, SSH):
# sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setblockall on >/dev/null

##### Guest account ##########################################################
#
# Disable and remove.

sudo defaults write /Library/Preferences/com.apple.loginwindow GuestEnabled -bool false
# dscl reports errors on stdout, so check first.
if dscl . -read /Users/Guest >/dev/null 2>&1; then
  sudo dscl . -delete /Users/Guest
fi

##### Login window #############################################################
#
# Username field instead of the account picker.
sudo defaults write /Library/Preferences/com.apple.loginwindow SHOWFULLNAME -bool true

##### Power management #######################################################
#
# By the host's `kind` in .chezmoidata.yaml; unknown hosts get the laptop
# profile.
{{ if eq $kind "desktop" }}
# Desktop (omlx server): only the display sleeps. No standby, hibernation,
# Power Nap or Low Power Mode. Restart after a power cut; wake on LAN and TCP
# keepalive as backups.
sudo pmset -a sleep 0 disksleep 0 standby 0 hibernatemode 0 \
  powernap 0 lowpowermode 0 displaysleep 15 autorestart 1 womp 1 tcpkeepalive 1
{{- else }}
# Laptop: sleep when idle, sooner on battery than on AC.
sudo pmset -b sleep 5 displaysleep 5 disksleep 10 standby 1 powernap 0
sudo pmset -c sleep 10 displaysleep 10 disksleep 10 powernap 0
{{- end }}
# Lock on wake is askForPassword in the defaults script; pmset can't.

##### Hostname ################################################################
# All names set to computerName (from `chezmoi init`), else the current
# hostname.
sudo scutil --set ComputerName {{ $host | quote }}
sudo scutil --set HostName {{ $host | quote }}
sudo scutil --set LocalHostName {{ $host | quote }}
sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server \
  NetBIOSName -string {{ $host | quote }}

##### Software Update #########################################################
#
# Check for macOS updates, but never download or install them unasked (that
# is how Tahoe arrived). Install by hand: `softwareupdate -l` / `-i <label>`.
# Security stays automatic:
#   - ConfigDataInstall: XProtect, Gatekeeper and malware data; no restart.
#   - CriticalUpdateInstall: Rapid Security Responses; at most a short restart.
# Point releases (26.x.y) are macOS updates, even security-only ones.
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool false
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate ConfigDataInstall -bool true
sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true

{{ if eq $kind "desktop" -}}
##### GPU wired memory ########################################################
#
# macOS caps GPU-wired memory, and so the model size omlx can load. Raise it
# to omlx's ceiling for this host (wiredLimitMb in .chezmoidata.yaml); more
# can get omlx killed mid-load, stranding memory until a reboot. The sysctl
# resets at boot, so a LaunchDaemon reapplies it; it is also set now.
{{- $wired := dig $host "wiredLimitMb" "" .hosts }}
{{- if not $wired }}
{{-   fail (printf "hosts.%s.wiredLimitMb is not set in .chezmoidata.yaml" $host) }}
{{- end }}
WIRED='sysctl -w iogpu.wired_limit_mb={{ $wired }}'
sudo tee /Library/LaunchDaemons/com.dolfth.wired-limit.plist >/dev/null <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dolfth.wired-limit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>$WIRED</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF
sudo sh -c "$WIRED" >/dev/null

##### Screen Sharing ##########################################################
#
# vnc://gza.local or the tailnet name. Access: System Settings > General >
# Sharing > Screen Sharing (admins by default). If it doesn't show as on
# there, toggle it once by hand.
sudo launchctl enable system/com.apple.screensharing
sudo launchctl bootstrap system /System/Library/LaunchDaemons/com.apple.screensharing.plist 2>/dev/null || true

##### Remote Login (SSH) #####################################################
#
# Also the way back after a power cut: on Apple silicon with macOS 26+, a
# minimal sshd runs before FileVault unlocks. `ssh dolf@gza.local` with the
# account password (keys don't work there) unlocks the disk; SSH drops and
# the Mac boots normally. See `man apple_ssh_and_filevault`. So password auth
# must stay on. launchctl, as `systemsetup -setremotelogin on` needs Full
# Disk Access.
sudo launchctl enable system/com.openssh.sshd
sudo launchctl bootstrap system /System/Library/LaunchDaemons/ssh.plist 2>/dev/null || true

{{ end -}}
##### FileVault ################################################################
#
# Not automatable: `fdesetup enable` handles the recovery key interactively,
# and the key must not go to stdout.

if ! fdesetup status | grep -q "FileVault is On"; then
  echo "  FileVault is OFF. Enable it: System Settings > Privacy & Security"
fi

##### Manual checklist ########################################################
#
# Not scriptable (the TCC database is SIP-protected):
#   - Full Disk Access for the terminal (~/Library/Mail, /dev)
#   - Accessibility for window managers and hotkey tools
#   - Screen Recording for capture tools
#   - iCloud sign-in and services

echo "==> System settings applied."
{{- end }}

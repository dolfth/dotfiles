{{- if and (eq .chezmoi.os "darwin") (eq (includeTemplate "kind" .) "desktop") -}}
#!/bin/bash
set -euo pipefail

# (Re)loads the omlx LaunchAgent on the desktop when its plist changes:
#   {{ includeTemplate "private_Library/LaunchAgents/com.dolfth.omlx.plist.tmpl" . | sha256sum }}
# after_: runs once files are written; in name order it would run before the
# plist exists.

PLIST="$HOME/Library/LaunchAgents/com.dolfth.omlx.plist"
DOMAIN="gui/$(id -u)"

if [ ! -x /opt/homebrew/opt/omlx/bin/omlx ]; then
  echo "omlx not installed yet -- skipping LaunchAgent" >&2
  exit 0
fi

# brew's own service would be a second, throttled copy on the same port.
brew services stop omlx >/dev/null 2>&1 || true

launchctl bootout "$DOMAIN/com.dolfth.omlx" 2>/dev/null || true
# bootout returns before launchd drops the job; bootstrapping too early fails
# with "5: Input/output error".
for _ in {1..20}; do launchctl print "$DOMAIN/com.dolfth.omlx" >/dev/null 2>&1 || break; sleep 0.5; done
launchctl bootstrap "$DOMAIN" "$PLIST"
echo "==> omlx LaunchAgent loaded (log: ~/Library/Logs/omlx.log)"
{{- end -}}

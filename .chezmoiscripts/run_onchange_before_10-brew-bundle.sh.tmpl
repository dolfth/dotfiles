{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Re-runs when the rendered Brewfile changes:
#   {{ includeTemplate "dot_Brewfile.tmpl" . | sha256sum }}
#
# Runs before chezmoi writes ~/.Brewfile, which a fresh Mac lacks, so the
# template is rendered to a temp file. Third-party casks carry `trusted: true`.

# On bootstrap, Homebrew (00) is installed but not yet on chezmoi's PATH.
if ! command -v brew >/dev/null 2>&1 && [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed -- skipping brew bundle." >&2
  echo "run_once_before_00-homebrew.sh should have installed it; see its output." >&2
  exit 0
fi

BREWFILE=$(mktemp)
trap 'rm -f "$BREWFILE"' EXIT
cat > "$BREWFILE" <<'BREWFILE_EOF'
{{ includeTemplate "dot_Brewfile.tmpl" . -}}
BREWFILE_EOF

# A failed install (network, macOS too old for a cask) mustn't block the
# dotfiles: warn and exit 0. chezmoi won't retry until the Brewfile changes,
# so retry by hand. Cleanup is skipped, so a partial run uninstalls nothing.
if brew bundle install --file "$BREWFILE"; then
  brew bundle cleanup --file "$BREWFILE" --force
else
  echo >&2
  echo "WARNING: brew bundle had failures (see 'has failed!' above); cleanup skipped." >&2
  echo "         Fix the cause, then retry with: brew bundle --global && brew bundle cleanup --global --force" >&2
fi
{{- end -}}

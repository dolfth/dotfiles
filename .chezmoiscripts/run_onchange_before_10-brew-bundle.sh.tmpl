{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Re-runs only when the rendered Brewfile changes, via this hash of it:
#   {{ includeTemplate "dot_Brewfile.tmpl" . | sha256sum }}
#
# This is a run_onchange_before_ script: it runs BEFORE chezmoi writes
# dot_Brewfile.tmpl -> ~/.Brewfile. On a clean Mac that file does not exist
# yet, and `brew bundle --global` (which looks for ~/.Brewfile) dies with
# "No Brewfile found", aborting the whole apply. The source is a template (it
# differs per host), so render it into a temp file and point brew bundle there.
# The non-official casks carry `trusted: true`, so they are trusted and
# installed exactly as before.

# On the bootstrap run, run_once_before_00-homebrew.sh has just installed
# Homebrew, but chezmoi's PATH predates it.
if ! command -v brew >/dev/null 2>&1 && [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed -- skipping brew bundle." >&2
  echo "run_once_before_00-homebrew.sh should have installed it; see its output." >&2
  exit 0
fi

BREWFILE=$(mktemp)
trap 'rm -f "$BREWFILE"' EXIT
cat > "$BREWFILE" <<'BREWFILE_EOF'
{{ includeTemplate "dot_Brewfile.tmpl" . -}}
BREWFILE_EOF

# A failed install (network, firewall, macOS too old for a cask) must not
# block the dotfiles: warn and exit 0 instead. chezmoi then counts this script
# as done and won't retry it until the Brewfile changes, so retry by hand.
# Cleanup is skipped after a failure, so nothing is uninstalled on a
# half-finished run.
if brew bundle install --file "$BREWFILE"; then
  brew bundle cleanup --file "$BREWFILE" --force
else
  echo >&2
  echo "WARNING: brew bundle had failures (see 'has failed!' above); cleanup skipped." >&2
  echo "         Fix the cause, then retry with: brew bundle --global && brew bundle cleanup --global --force" >&2
fi
{{- end -}}

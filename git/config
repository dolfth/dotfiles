# Managed by mise.
#
# Sign with the host's SSH key -- the private key, not the .pub: a .pub only
# works while an ssh-agent holds the key. Verification uses allowed_signers
# (vars.ssh_keys in mise.toml).
[user]
name = Dolf ter Hofsté
email = 12677636+dolfth@users.noreply.github.com
signingkey = ~/.ssh/id_ed25519
[init]
defaultBranch = main
[Pull]
rebase = true
[gpg]
format = ssh
[gpg "ssh"]
allowedSignersFile = ~/.config/git/allowed_signers
[commit]
gpgsign = true
[tag]
gpgsign = true

# Keys trusted for `git log --show-signature` and `git verify-commit`.
# The ssh_keys var is newline-separated, so the template just iterates it
# (mise vars are scalars only).
{% for key in vars.ssh_keys | trim | split(pat="\n") %}12677636+dolfth@users.noreply.github.com namespaces="git" {{ key }}
{% endfor %}

{{- /* Plain files that only make sense on macOS. Scripts are NOT listed here:
       they guard their own bodies with a template conditional and render empty
       elsewhere, which chezmoi skips. */ -}}
{{ if ne .chezmoi.os "darwin" -}}
.Brewfile
.zshrc
.omlx/stats.json
{{ end -}}
{{- /* The omlx LaunchAgent only belongs on the desktop (omlx server). */ -}}
{{- $host := get . "computerName" | default .chezmoi.hostname -}}
{{ if ne (dig $host "kind" "laptop" .hosts) "desktop" -}}
Library/LaunchAgents/com.dolfth.omlx.plist
{{ end -}}
README.md

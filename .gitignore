# Per-machine config: which environment modules to load (see the README).
miserc.local.toml
# mise's own runtime state.
*.log
mise.lock
# omp's config lock: the deployed config is a symlink into the repo, so omp
# realpaths it and drops its 0-byte flock sentinel here. Inert once omp
# exits; reappears on every run.
omp/agent/*.lock
# omp's session lock for an in-memory db: the `<dbPath>.ses` sidecar derives
# from SQLite's `:memory:` name without special-casing it, so it lands in the
# cwd. Rewritten on every interactive run; upstream, not yet reported.
:memory:.ses

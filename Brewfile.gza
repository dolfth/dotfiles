# gza only: local-LLM servers and tagent stack. Servers' LaunchAgents
# are declared in mise.gza.toml, as `brew services` would be a second,
# throttled copy on the same port. 
# Omp binary is a pinned release in dev-agents.

# url: the tap does not clone by name; it lives in the main omlx repo.
tap "jundot/omlx", url: "https://github.com/jundot/omlx", trusted: true
tap "incoai/homebrew-tap", trusted: true
tap "mostlygeek/llama-swap", trusted: true

brew "omlx"
brew "splash"
brew "llama-swap"

brew "herdr"
brew "nono"

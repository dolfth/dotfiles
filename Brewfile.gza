# gza's brew entries: the local-LLM servers and the agent stack (herdr, nono; the omp
# binary itself is the dev-agents task's pinned release, not a formula). The LaunchAgents
# that run the servers are in mise.gza.toml (run by mise, not `brew services` -- a brew
# service would be a second, throttled copy on the same port). For the Brewfile mechanism
# itself, see Brewfile.

# trusted: true -- Homebrew 6+ refuses to load formulae from untrusted taps and the
# trust state is per-machine (~/.homebrew/trust.json), never the Brewfile.
# url: -- the tap moved from the (now 404) homebrew-omlx repo into the main omlx repo,
# which bare `brew tap jundot/omlx` does not clone by name; the formula ref stays plain.
tap "jundot/omlx", url: "https://github.com/jundot/omlx", trusted: true
# Upstream renamed incoai/tap to incoai/homebrew-tap (old name 404s);
# formula and keg names unchanged.
tap "incoai/homebrew-tap", trusted: true

brew "omlx"
brew "splash"
# The pool's front door: one endpoint, one model resident at a time (same
# trusted-tap note as above).
tap "mostlygeek/llama-swap", trusted: true
brew "llama-swap"

# The agent stack, gza-only: the laptop reaches it over ssh/mosh instead of installing
# it. `omp` on PATH is the root-owned wrapper the dev-agents task installs (herdr
# launches agents by PATH name, so every launch is sandboxed); the raw binary stays
# omp-unsandboxed. The Brewfile carries the tools, the task the policy.
brew "herdr"
brew "nono"

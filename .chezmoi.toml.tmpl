{{- /* Generated by `chezmoi init`; answers are remembered, so re-running init
       does not ask again. On macOS the name becomes ComputerName/HostName/
       LocalHostName and selects this host's entry in .chezmoidata.yaml
       (prompt accent, power profile). */ -}}
{{- if eq .chezmoi.os "darwin" }}
{{- $computerName := promptStringOnce . "computerName" "Machine name (e.g. mca, gza)" .chezmoi.hostname }}
[data]
computerName = {{ $computerName | quote }}
{{- end }}
